<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Performance Optimizations -->
		<BlazorEnableCompression>true</BlazorEnableCompression>
		
		<!-- Trimming Support -->
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsTrimmable>true</IsTrimmable>
		<TrimMode>partial</TrimMode>
		
		<!-- AOT Support -->
		<PublishAot>false</PublishAot>
	</PropertyGroup>
	
	<ItemGroup>
	  <ApplicationDefinition Include="Resources\Resource.en.resx" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.3" />
		<PackageReference Include="Radzen.Blazor" Version="9.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AFS.Core\AFS.Core.csproj" />
	</ItemGroup>

	<!-- Trimmer configuration to preserve Blazor components for property injection -->
	<ItemGroup>
		<TrimmerRootDescriptor Include="TrimmerRoots.xml" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\JsInterop.js">
			<SubType>Code</SubType>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Resource.de.resx">
		<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Resource.es.resx">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Resource.fr.resx">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Resource.resx">
		  <SubType>Designer</SubType>
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Resource.ru.resx">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Resource.ua.resx">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>
	
	<!-- Preserve Resource class for localization -->
	<ItemGroup>
		<TrimmerRootAssembly Include="AFS.ComponentLibrary" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Update="Meziantou.Analyzer" Version="3.0.19" />
	  <PackageReference Update="Roslynator.Analyzers" Version="4.15.0" />
	  <PackageReference Update="SonarAnalyzer.CSharp" Version="10.20.0.135146" />
	</ItemGroup>

</Project>
