<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<NeutralLanguage>uk-UA</NeutralLanguage>
		<!-- Enable trimming - source generator provides AOT-safe localization -->
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
		<PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.3" />
		<PackageReference Include="Radzen.Blazor" Version="9.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AFS.Core\AFS.Core.csproj" />
		<!-- Source generator for AOT-safe localization -->
		<ProjectReference Include="..\AFS.Generators\AFS.Generators.csproj" 
						  OutputItemType="Analyzer" 
						  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Resources\Resource.Designer.cs">
		<DesignTime>True</DesignTime>
		<AutoGen>True</AutoGen>
		<DependentUpon>Resource.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<!-- Localization Resources - PUBLIC code generator for Resource.Designer.cs -->
	<ItemGroup>
		<EmbeddedResource Update="Resources\Resource.resx" Generator="PublicResXFileCodeGenerator" LastGenOutput="Resource.Designer.cs" />
	</ItemGroup>

	<!-- Pass .resx files to the source generator -->
	<ItemGroup>
		<AdditionalFiles Include="Resources\*.resx" />
	</ItemGroup>

</Project>
