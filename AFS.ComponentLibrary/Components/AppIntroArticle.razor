@*
    Visible, always-rendered intro block for the landing page (MainInputComponent).

    WHY THIS EXISTS
    ---------------
    Blazor WebAssembly replaces <div id="app">'s contents on hydration, which
    overwrites the pre-hydration hero in index.html. That leaves Googlebot's
    rendered-pass DOM with only <RadzenTabs> — six empty input tabs — which its
    Soft 404 classifier judges as thin/error content. Result: "?lang=en" and
    the root URL are both flagged "Excluded — Soft 404" in Search Console.

    This component renders ~250 words of substantive, indexable content (H1,
    descriptive paragraph, four-item feature grid, four deep links) ABOVE the
    tabs so the hydrated DOM always has real content. Survives Blazor's
    #app rewrite because it IS part of the Blazor view.

    All strings are localised via ResLoc against AFS.ComponentLibrary's shared
    .resx set (15 cultures: uk/en/pl/ro/hu/cs/de/nl/fr/it/es/tr/zh/ja/ru), so
    the rendered DOM matches whichever culture the user (or Accept-Language)
    selected. Pre-hydration hero in index.html remains English-only as a
    fallback for crawlers that hit the page before Blazor boots.

    Note: <h1> may receive tabindex="-1" at runtime from FocusOnNavigate so
    keyboard/SR users land on the new page heading after route changes.
*@

@inject NavigationManager Navigation
@inject IJSRuntime JS

<article class="app-intro" aria-labelledby="app-intro-heading">
    <div class="app-intro__header">
        <h1 id="app-intro-heading" class="app-intro__heading">
            @ResLoc["IntroHeading"]
        </h1>

        <button type="button"
                class="app-intro__toggle"
                @onclick="ToggleCollapsedAsync"
                aria-expanded="@(!_isCollapsed)"
                aria-controls="app-intro-content"
                aria-label="@ToggleLabel">
            <span aria-hidden="true">@ToggleIcon</span>
            <span>@ToggleLabel</span>
        </button>
    </div>

    @if (!_isCollapsed)
    {
        <div id="app-intro-content">
            <p class="app-intro__lede">
                @ResLoc["IntroLede"]
            </p>

            @* Feature values contain inline <strong> tags, so they must be rendered
               as MarkupString. The strings come from .resx and are safe,
               author-controlled content — not user input. *@
            <ul class="app-intro__features">
                <li>@((MarkupString)ResLoc["IntroFeatureLiquidity"].Value)</li>
                <li>@((MarkupString)ResLoc["IntroFeatureProfitability"].Value)</li>
                <li>@((MarkupString)ResLoc["IntroFeatureBusinessActivity"].Value)</li>
                <li>@((MarkupString)ResLoc["IntroFeatureAI"].Value)</li>
            </ul>

            @* Real <nav> + <ul> so screen readers announce a navigation landmark
               and a list of N items. The "·" visual separators are CSS-only
               (li + li::before) so AT users don't hear "middle dot" between links. *@
            <nav class="app-intro__jump" aria-label="@ResLoc["IntroJumpAriaLabel"]">
                <span class="app-intro__jump-prefix">@ResLoc["IntroJumpPrefix"]</span>
                <ul class="app-intro__jump-list">
                    <li><NavLink href="@AppHref("liquidityindicatorsofbalance")">@ResLoc["IntroJumpLiquidity"]</NavLink></li>
                    <li><NavLink href="@AppHref("solvencyratios")">@ResLoc["IntroJumpSolvency"]</NavLink></li>
                    <li><NavLink href="@AppHref("indicatorsofbusinessactivity")">@ResLoc["IntroJumpBusinessActivity"]</NavLink></li>
                    <li><NavLink href="@AppHref("generalindicatorsoffinancialstability")">@ResLoc["IntroJumpStability"]</NavLink></li>
                </ul>
                <span class="app-intro__jump-suffix">— @ResLoc["IntroJumpSuffix"]</span>
            </nav>
        </div>
    }
</article>

@code {
    private const string CollapseStorageKey = "ufin.appIntro.collapsed";
    private bool _isCollapsed;

    private string ToggleLabel => _isCollapsed ? ResLoc["IntroShow"] : ResLoc["IntroHide"];
    private string ToggleIcon => _isCollapsed ? "+" : "−";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var storedValue = await JS.InvokeAsync<string?>("localStorage.getItem", CollapseStorageKey);
        if (bool.TryParse(storedValue, out var isCollapsed))
        {
            _isCollapsed = isCollapsed;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleCollapsedAsync()
    {
        _isCollapsed = !_isCollapsed;
        await JS.InvokeVoidAsync("localStorage.setItem", CollapseStorageKey, _isCollapsed.ToString());
    }

    private string AppHref(string relativePath)
    {
        var baseRelativePath = Navigation.ToBaseRelativePath(Navigation.BaseUri);
        var appBasePath = string.IsNullOrEmpty(baseRelativePath) ? "/" : $"/{baseRelativePath.TrimEnd('/')}/";

        return $"{appBasePath}{relativePath.TrimStart('/')}";
    }
}
