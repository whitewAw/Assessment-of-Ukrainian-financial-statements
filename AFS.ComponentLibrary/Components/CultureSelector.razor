@using System.Globalization
@inject ICultureStorageHandler CultureHandler
@inject NavigationManager Navigator

<div class="culture-selector" role="region" aria-label="@selectLanguageLabel">
    <RadzenDropDown TValue="CultureInfo"
                    Data="@supportedCultures"
                    @bind-Value="@currentCulture"
                    Change="CultureChanged"
                    Style="min-width: 150px;"
                    Placeholder="@selectLanguageLabel"
                    aria-label="@selectLanguageLabel">
        <Template Context="culture">
            @(GetDisplayText((CultureInfo)culture))
        </Template>
    </RadzenDropDown>
</div>

@code {
    private static readonly Dictionary<string, (string Flag, string NativeName)> cultureDisplayData = new()
    {
        ["en"] = ("🇺🇸", "English"),
        ["uk-UA"] = ("🇺🇦", "Українська"),
        ["ru"] = ("🇷🇺", "Русский"),
        ["es"] = ("🇪🇸", "Español"),
        ["de"] = ("🇩🇪", "Deutsch"),
        ["fr"] = ("🇫🇷", "Français")
    };

    private readonly IReadOnlyList<CultureInfo> supportedCultures = new[]
    {
        CultureInfo.GetCultureInfo("en"),
        CultureInfo.GetCultureInfo("uk-UA"),
        CultureInfo.GetCultureInfo("ru"),
        CultureInfo.GetCultureInfo("es"),
        CultureInfo.GetCultureInfo("de"),
        CultureInfo.GetCultureInfo("fr")
    };

    private CultureInfo currentCulture = CultureInfo.GetCultureInfo("en");
    private string selectLanguageLabel => ResLoc?["SelectLanguage"] ?? "Select Language";

    private static string GetFlag(CultureInfo culture) =>
        cultureDisplayData.TryGetValue(culture.Name, out var data) ? data.Flag : "🌐";

    private static string GetNativeName(CultureInfo culture) =>
        cultureDisplayData.TryGetValue(culture.Name, out var data) ? data.NativeName : culture.NativeName;

    private static string GetDisplayText(CultureInfo culture) =>
        $"{GetFlag(culture)} {GetNativeName(culture)}";

    protected override void OnInitialized()
    {
        // Get the current culture and find the matching supported culture
        var current = CultureInfo.DefaultThreadCurrentCulture ?? CultureInfo.CurrentCulture;

        // Try to find exact match first, then by two-letter ISO code
        var matchingCulture = supportedCultures.FirstOrDefault(c => c.Name == current.Name) ??
                             supportedCultures.FirstOrDefault(c => c.TwoLetterISOLanguageName == current.TwoLetterISOLanguageName);

        currentCulture = matchingCulture ?? CultureInfo.GetCultureInfo("en");

        base.OnInitialized();
    }

    private async Task CultureChanged(object? param)
    {
        if (param is CultureInfo newCulture)
        {
            try
            {
                await CultureHandler.WriteCultureAsync(newCulture);
                Navigator.NavigateTo(Navigator.Uri, forceLoad: true);
            }
            catch (Exception ex)
            {
                // Log error but don't break the app
                Console.Error.WriteLine($"Failed to change culture: {ex.Message}");
            }
        }
    }
}
