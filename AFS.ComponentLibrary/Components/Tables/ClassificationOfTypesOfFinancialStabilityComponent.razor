@page "/classificationoftypesoffinancialstability"
@inject ClassificationOfTypesOfFinancialStability ClassificationOfTypesOfFinancialStability
@inject AfsModel AfsModel
<SeoHead Title="Financial Stability Classification | UFIN"
         Description="Classify a Ukrainian business into one of four financial-stability types (absolute, normal, unstable, crisis) based on the three-component stability indicator." />

<RadzenCard Style="width: 100%;">
    <h2 class="text-center">@tableName</h2>
    <table class="table table-bordered py-0 table-sm table-striped">
        <thead>
            <tr>
                <ThComponent Rowspan=2>@ResLoc["NumberInOrder"]</ThComponent>
                <ThComponent Rowspan=2>@ResLoc["StabilityType"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["Current"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["InShortTerm"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["InLongTerm"]</ThComponent>
            </tr>
            <tr>
                <ThComponent>@atEndOfBase</ThComponent>
                <ThComponent>@atEndOfCurrent</ThComponent>
                <ThComponent>@atEndOfBase</ThComponent>
                <ThComponent>@atEndOfCurrent</ThComponent>
                <ThComponent>@atEndOfBase</ThComponent>
                <ThComponent>@atEndOfCurrent</ThComponent>
            </tr>
        </thead>
        <tbody>
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.AbsoluteFinancialStability
                                                                  Name=@ResLoc["AbsoluteFinancialStabilityInit"]
                                                                  CName=@ResLoc["A1P1"]
                                                                  ShortName=@ResLoc["A1P1P2"]
                                                                  LongName=@ResLoc["A1P1P2P3"] />
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.NormalFinancialStability
                                                                  Name=@ResLoc["NormalFinancialStability"]
                                                                  CName=@ResLoc["A1A2P1"]
                                                                  ShortName=@ResLoc["A1A2P1P2"]
                                                                  LongName=@ResLoc["A1A2P1P2P3"] />
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.PreCrisisFinancialStability
                                                                  Name=@ResLoc["PreCrisisFinancialStability"]
                                                                  CName=@ResLoc["A1A2A3P1"]
                                                                  ShortName=@ResLoc["A1A2A3P1P2"]
                                                                  LongName=@ResLoc["A1A2A3P1P2P3"] />
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.CrisisFinancialStability
                                                                  Name=@ResLoc["CrisisFinancialStability"]
                                                                  CName=@ResLoc["A1A2A3<P1"]
                                                                  ShortName=@ResLoc["A1A2A3<P1P2"]
                                                                  LongName=@ResLoc["A1A2A3<P1P2P3"] />
        </tbody>
    </table>
</RadzenCard>

<AIAnalysisPanel PromptBuilder="@BuildStabilityClassificationPrompt"
                 AnalyzeButtonLabel="@ResLoc["AnalyzeStabilityClassification"]"
                 LoadingMessage="AI is analyzing financial stability classification..." />

@code {
    // Set when the component is disposed. Checked inside the AI streaming callback to
    // prevent StateHasChanged() from being invoked on a disposed component (e.g. if the
    // user navigates away mid-analysis) and to release captured references for GC faster.
        private string? tableName;
    private string? atEndOfBase;
    private string? atEndOfCurrent;
    protected override async Task OnInitializedAsync()
    {
        string name = ResLoc["ClassificationOfTypesOfFinancialStability"];
        int number = 16;

        tableName = String.Format("{0} {1}. {2} {3} {4}-{5} {6}", ResLoc["Table"], number, name, MainModel.CompanyName, MainModel.BaseYear, MainModel.CurrentYear, ResLoc["years"]);
        atEndOfBase = String.Format(ResLoc["atEndOf"], MainModel.BaseYear);
        atEndOfCurrent = String.Format(ResLoc["atEndOf"], MainModel.CurrentYear);
        await base.OnInitializedAsync();
    }

                private string BuildStabilityClassificationPrompt()
    {
        string languageInstruction = AfsConstraints.GetLanguageInstruction();

        // Use AOT-optimized JSON serialization
        var jsonData = AFS.Core.Services.JsonSerializationHelper.SerializeStabilityClassification(
            MainModel.CompanyName,
            MainModel.BaseYear,
            MainModel.CurrentYear,
            ClassificationOfTypesOfFinancialStability.AbsoluteFinancialStability,
            ClassificationOfTypesOfFinancialStability.NormalFinancialStability,
            ClassificationOfTypesOfFinancialStability.PreCrisisFinancialStability,
            ClassificationOfTypesOfFinancialStability.CrisisFinancialStability
        );

        return $@"You are a financial analyst specializing in financial stability assessment, credit risk analysis, and bankruptcy prediction. Analyze the following Classification of Types of Financial Stability for {MainModel.CompanyName}.

IMPORTANT: Respond in {languageInstruction} language. The user interface is in {languageInstruction}, so your entire response must be in {languageInstruction}.

CRITICAL FORMATTING RULES:
- DO NOT create or display any tables
- DO NOT repeat raw data values in table format
- The user can see all data in the table above
- Focus on INTERPRETATION, INSIGHTS, and RECOMMENDATIONS
- Use narrative prose with clear sections and bullet points
- Reference numbers naturally in sentences

DATA STRUCTURE:
This table provides the FINAL VERDICT on financial stability by testing the company against FOUR stability types across THREE time perspectives (Current, Short-term, Long-term) for TWO years ({MainModel.BaseYear} and {MainModel.CurrentYear}).

THE FOUR TYPES OF FINANCIAL STABILITY:

**Type 1: Absolute Financial Stability**
- BEST classification, very rare
- Tests: Cash (A1) alone must cover liabilities
  â€¢ Current: A1 = P1 (urgent payables)
  â€¢ Short-term: A1 = P1+P2 (urgent + short-term)
  â€¢ Long-term: A1 = P1+P2+P3 (all liabilities)
- Interpretation: Maximum financial independence
- Risk: Minimal, ultra-conservative
- Implication: Company can pay ALL obligations from cash alone

**Type 2: Normal Financial Stability**
- GOOD classification, common and healthy
- Tests: Liquid assets (A1+A2) must cover liabilities
  â€¢ Current: A1+A2 = P1 (cash + receivables cover urgent)
  â€¢ Short-term: A1+A2 = P1+P2 (liquid assets cover short-term)
  â€¢ Long-term: A1+A2 = P1+P2+P3 (liquid assets cover all)
- Interpretation: Acceptable financial position
- Risk: Low, sustainable
- Implication: Normal operations, good credit standing

**Type 3: Pre-Crisis Financial Stability**
- RISKY classification, unstable
- Tests: ALL current assets (A1+A2+A3) must cover liabilities
  â€¢ Current: A1+A2+A3 = P1 (all current covers urgent)
  â€¢ Short-term: A1+A2+A3 = P1+P2 (all current covers short-term)
  â€¢ Long-term: A1+A2+A3 = P1+P2+P3 (all current covers all)
- Interpretation: Dependent on inventory liquidation
- Risk: Medium-High, refinancing vulnerable
- Implication: Pre-crisis warning, action needed

**Type 4: Crisis Financial Stability**
- WORST classification, critical state
- Tests: Cannot cover liabilities even with ALL current assets
  â€¢ Current: A1+A2+A3 < P1 (cannot pay urgent)
  â€¢ Short-term: A1+A2+A3 < P1+P2 (cannot pay short-term)
  â€¢ Long-term: A1+A2+A3 < P1+P2+P3 (cannot pay all)
- Interpretation: Insolvency risk, bankruptcy potential
- Risk: CRITICAL, emergency
- Implication: Cannot meet obligations, crisis intervention required

ASSET GROUPING (A1, A2, A3):
- **A1 - Most Liquid:** Cash and equivalents
- **A2 - Quick-Liquid:** Receivables and near-cash
- **A3 - Slow-Liquid:** Inventory and prepayments

LIABILITY GROUPING (P1, P2, P3):
- **P1 - Most Urgent:** Current payables (immediate)
- **P2 - Short-term:** Short-term loans (within year)
- **P3 - Long-term:** Long-term debt (after year)

Financial Classification Data ({MainModel.BaseYear}-{MainModel.CurrentYear}):
{jsonData}

