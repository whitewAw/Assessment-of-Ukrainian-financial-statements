@page "/classificationoftypesoffinancialstability"
@using AFS.Core.Interfaces
@using AFS.Core.Services
@inject ClassificationOfTypesOfFinancialStability ClassificationOfTypesOfFinancialStability
@inject AfsModel AfsModel
@inject IAIFinancialAdvisor AIAdvisor
@inject IJSRuntime JS

<RadzenCard Style="width: 100%;">
    <h2 class="text-center">@tableName</h2>
    <table class="table table-bordered py-0 table-sm table-striped">
        <thead>
            <tr>
                <ThComponent Rowspan=2>@ResLoc["NumberInOrder"]</ThComponent>
                <ThComponent Rowspan=2>@ResLoc["StabilityType"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["Current"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["InShortTerm"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["InLongTerm"]</ThComponent>
            </tr>
            <tr>
                <ThComponent>@atEndOfBase</ThComponent>
                <ThComponent>@atEndOfCurrent</ThComponent>
                <ThComponent>@atEndOfBase</ThComponent>
                <ThComponent>@atEndOfCurrent</ThComponent>
                <ThComponent>@atEndOfBase</ThComponent>
                <ThComponent>@atEndOfCurrent</ThComponent>
            </tr>
        </thead>
        <tbody>
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.AbsoluteFinancialStability
                                                                  Name=@ResLoc["AbsoluteFinancialStabilityInit"]
                                                                  CName=@ResLoc["A1P1"]
                                                                  ShortName=@ResLoc["A1P1P2"]
                                                                  LongName=@ResLoc["A1P1P2P3"] />
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.NormalFinancialStability
                                                                  Name=@ResLoc["NormalFinancialStability"]
                                                                  CName=@ResLoc["A1A2P1"]
                                                                  ShortName=@ResLoc["A1A2P1P2"]
                                                                  LongName=@ResLoc["A1A2P1P2P3"] />
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.PreCrisisFinancialStability
                                                                  Name=@ResLoc["PreCrisisFinancialStability"]
                                                                  CName=@ResLoc["A1A2A3P1"]
                                                                  ShortName=@ResLoc["A1A2A3P1P2"]
                                                                  LongName=@ResLoc["A1A2A3P1P2P3"] />
            <TrClassificationOfTypesOfFinancialStabilityComponent Item=ClassificationOfTypesOfFinancialStability.CrisisFinancialStability
                                                                  Name=@ResLoc["CrisisFinancialStability"]
                                                                  CName=@ResLoc["A1A2A3<P1"]
                                                                  ShortName=@ResLoc["A1A2A3<P1P2"]
                                                                  LongName=@ResLoc["A1A2A3<P1P2P3"] />
        </tbody>
    </table>
</RadzenCard>

@* @ResLoc["AIFinancialAnalysis"] Section *@
<RadzenCard Style="width: 100%; margin-top: 20px;">
    <h3 class="text-center mb-4">
        <i class="oi oi-brain me-2"></i>
        @ResLoc["AIFinancialAnalysis"]
    </h3>
    
    @if (_isCheckingAvailability)
    {
        <div class="d-flex justify-content-center mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span class="text-muted">@ResLoc["CheckingAIAvailability"]</span>
        </div>
    }
    else if (!_isAIAvailable)
    {
        <div class="alert alert-warning">
            <h6 class="alert-heading">
                <i class="oi oi-warning me-2"></i>
                @ResLoc["ChromeAINotAvailable"]
            </h6>
            <p class="mb-2">
                @ResLoc["ChromeAINotAvailableMessage"]
                <a href="/Assessment-of-Ukrainian-financial-statements/ai-assistant" class="alert-link">@ResLoc["AIAssistantPage"]</a>
                @ResLoc["ForSetupInstructions"]
            </p>
            <button class="btn btn-sm btn-primary" @onclick="CheckAIAvailability">
                <i class="oi oi-reload me-2"></i>
                @ResLoc["RecheckAvailability"]
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3">
            @if (_isAnalyzing)
            {
                <button class="btn btn-danger me-2" @onclick="StopAnalysis">
                    <i class="oi oi-media-stop me-2"></i>
                    <span>@ResLoc["StopAnalysis"]</span>
                </button>
            }
            else
            {
                <button class="btn btn-primary me-2" @onclick="AnalyzeStabilityClassification" disabled="@(!_isAIAvailable)">
                    <i class="oi oi-magnifying-glass me-2"></i>
                    <span>@ResLoc["AnalyzeStabilityClassification"]</span>
                </button>
            }
            
            @if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAnalysis">
                    <i class="oi oi-x me-2"></i>
                    @ResLoc["Clear"]
                </button>
            }
        </div>

        @if (_isAnalyzing || !string.IsNullOrEmpty(_aiAnalysis))
        {
            <div class="alert alert-info">
                @if (_isAnalyzing && string.IsNullOrEmpty(_aiAnalysis))
                {
                    <div class="d-flex align-items-center">
                        <span class="typing-indicator me-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span class="text-muted">AI is analyzing financial stability classification...</span>
                    </div>
                }
                <div style="white-space: pre-wrap; line-height: 1.6;">
                    @((MarkupString)FormatAIResponse(_aiAnalysis))
                </div>
            </div>
        }
    }
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>@ResLoc["Error"]:</strong> @_errorMessage
        </div>
    }
</RadzenCard>

@code {
    private string? tableName;
    private string? atEndOfBase;
    private string? atEndOfCurrent;
    
    private string _aiAnalysis = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isAnalyzing = false;
    private bool _isCheckingAvailability = true;
    private bool _isAIAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        string name = ResLoc["ClassificationOfTypesOfFinancialStability"];
        int number = 16;

        tableName = String.Format("{0} {1}. {2} {3} {4}-{5} {6}", ResLoc["Table"], number, name, MainModel.CompanyName, MainModel.BaseYear, MainModel.CurrentYear, ResLoc["years"]);
        atEndOfBase = String.Format(ResLoc["atEndOf"], MainModel.BaseYear);
        atEndOfCurrent = String.Format(ResLoc["atEndOf"], MainModel.CurrentYear);
        
        await CheckAIAvailability();
        
        base.OnInitialized();
    }

    private async Task CheckAIAvailability()
    {
        _isCheckingAvailability = true;
        StateHasChanged();

        try
        {
            var (isAvailable, _) = await AIAdvisor.CheckAvailabilityAsync();
            _isAIAvailable = isAvailable;
        }
        catch (Exception)
        {
            _isAIAvailable = false;
        }
        finally
        {
            _isCheckingAvailability = false;
            StateHasChanged();
        }
    }

    private async Task AnalyzeStabilityClassification()
    {
        if (!_isAIAvailable)
        {
            _errorMessage = "Chrome AI is not available. Please check the setup instructions.";
            return;
        }

        _isAnalyzing = true;
        _errorMessage = string.Empty;
        _aiAnalysis = string.Empty;
        StateHasChanged();

        try
        {
            var prompt = BuildStabilityClassificationPrompt();
            
            await AIAdvisor.GetStreamingResponseAsync(prompt, chunk =>
            {
                _aiAnalysis += chunk;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("cancelled") || ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrEmpty(_aiAnalysis))
                {
                    _aiAnalysis += "\n\n[Analysis stopped by user]";
                }
                else
                {
                    _errorMessage = "Analysis was stopped by user.";
                }
            }
            else
            {
                _errorMessage = $"Failed to analyze data: {ex.Message}";
            }
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task StopAnalysis()
    {
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chromeai.js");
            await module.InvokeVoidAsync("abortCurrentOperation");

            // Note: The stopped message is added by the catch block in the analyze method

            _isAnalyzing = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping analysis: {ex.Message}");
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private string BuildStabilityClassificationPrompt()
    {
        string languageInstruction = AfsConstraints.GetLanguageInstruction();

        // Use AOT-optimized JSON serialization
        var jsonData = JsonSerializationHelper.SerializeStabilityClassification(
            MainModel.CompanyName,
            MainModel.BaseYear,
            MainModel.CurrentYear,
            ClassificationOfTypesOfFinancialStability.AbsoluteFinancialStability,
            ClassificationOfTypesOfFinancialStability.NormalFinancialStability,
            ClassificationOfTypesOfFinancialStability.PreCrisisFinancialStability,
            ClassificationOfTypesOfFinancialStability.CrisisFinancialStability
        );

        return $@"You are a financial analyst specializing in financial stability assessment, credit risk analysis, and bankruptcy prediction. Analyze the following Classification of Types of Financial Stability for {MainModel.CompanyName}.

IMPORTANT: Respond in {languageInstruction} language. The user interface is in {languageInstruction}, so your entire response must be in {languageInstruction}.

CRITICAL FORMATTING RULES:
- DO NOT create or display any tables
- DO NOT repeat raw data values in table format
- The user can see all data in the table above
- Focus on INTERPRETATION, INSIGHTS, and RECOMMENDATIONS
- Use narrative prose with clear sections and bullet points
- Reference numbers naturally in sentences

DATA STRUCTURE:
This table provides the FINAL VERDICT on financial stability by testing the company against FOUR stability types across THREE time perspectives (Current, Short-term, Long-term) for TWO years ({MainModel.BaseYear} and {MainModel.CurrentYear}).

THE FOUR TYPES OF FINANCIAL STABILITY:

**Type 1: Absolute Financial Stability**
- BEST classification, very rare
- Tests: Cash (A1) alone must cover liabilities
  • Current: A1 = P1 (urgent payables)
  • Short-term: A1 = P1+P2 (urgent + short-term)
  • Long-term: A1 = P1+P2+P3 (all liabilities)
- Interpretation: Maximum financial independence
- Risk: Minimal, ultra-conservative
- Implication: Company can pay ALL obligations from cash alone

**Type 2: Normal Financial Stability**
- GOOD classification, common and healthy
- Tests: Liquid assets (A1+A2) must cover liabilities
  • Current: A1+A2 = P1 (cash + receivables cover urgent)
  • Short-term: A1+A2 = P1+P2 (liquid assets cover short-term)
  • Long-term: A1+A2 = P1+P2+P3 (liquid assets cover all)
- Interpretation: Acceptable financial position
- Risk: Low, sustainable
- Implication: Normal operations, good credit standing

**Type 3: Pre-Crisis Financial Stability**
- RISKY classification, unstable
- Tests: ALL current assets (A1+A2+A3) must cover liabilities
  • Current: A1+A2+A3 = P1 (all current covers urgent)
  • Short-term: A1+A2+A3 = P1+P2 (all current covers short-term)
  • Long-term: A1+A2+A3 = P1+P2+P3 (all current covers all)
- Interpretation: Dependent on inventory liquidation
- Risk: Medium-High, refinancing vulnerable
- Implication: Pre-crisis warning, action needed

**Type 4: Crisis Financial Stability**
- WORST classification, critical state
- Tests: Cannot cover liabilities even with ALL current assets
  • Current: A1+A2+A3 < P1 (cannot pay urgent)
  • Short-term: A1+A2+A3 < P1+P2 (cannot pay short-term)
  • Long-term: A1+A2+A3 < P1+P2+P3 (cannot pay all)
- Interpretation: Insolvency risk, bankruptcy potential
- Risk: CRITICAL, emergency
- Implication: Cannot meet obligations, crisis intervention required

ASSET GROUPING (A1, A2, A3):
- **A1 - Most Liquid:** Cash and equivalents
- **A2 - Quick-Liquid:** Receivables and near-cash
- **A3 - Slow-Liquid:** Inventory and prepayments

LIABILITY GROUPING (P1, P2, P3):
- **P1 - Most Urgent:** Current payables (immediate)
- **P2 - Short-term:** Short-term loans (within year)
- **P3 - Long-term:** Long-term debt (after year)

Financial Classification Data ({MainModel.BaseYear}-{MainModel.CurrentYear}):
{jsonData}

RESPONSE FORMAT:
- Professional narrative style
- Headings with ** (e.g., **1. Executive Summary**)
- Bullet points (•) for lists
- Numbers integrated into sentences
- NO tables or raw data dumps
- Focus on CLASSIFICATION VERDICT and IMPLICATIONS

ANALYSIS SECTIONS:

**1. Executive Summary - Final Stability Verdict**:
   - 2-3 sentences on overall classification
   - PRIMARY FINDING: Which type? (1, 2, 3, or 4)
   - Consistency: Same type across all periods?
   - CRITICAL RISK LEVEL: (Minimal/Low/Medium/High/CRITICAL)
   - Immediate implications

**2. Classification Determination**:
   Determine the company's stability type for each time point:
   
   **{MainModel.BaseYear} End:**
   • Current perspective: [Type X]
   • Short-term perspective: [Type X]
   • Long-term perspective: [Type X]
   • OVERALL CLASSIFICATION: Type [X]
   
   **{MainModel.CurrentYear} End:**
   • Current perspective: [Type X]
   • Short-term perspective: [Type X]
   • Long-term perspective: [Type X]
   • OVERALL CLASSIFICATION: Type [X]
   
   **Consistency Check:**
   - Same type both years? [Yes/No]
   - Same type all perspectives? [Yes/No]
   - Trend: [Improving/Stable/Deteriorating]

**3. Type 1 Analysis (Absolute Stability)**:
   **{MainModel.BaseYear}:**
   - Current test: [PASS/FAIL] - A1 = P1
   - Short-term test: [PASS/FAIL] - A1 = P1+P2
   - Long-term test: [PASS/FAIL] - A1 = P1+P2+P3
   - Status: [All 3 must pass for Type 1]
   
   **{MainModel.CurrentYear}:**
   - Current test: [PASS/FAIL]
   - Short-term test: [PASS/FAIL]
   - Long-term test: [PASS/FAIL]
   - Status: [All 3 must pass for Type 1]
   
   **Interpretation:**
   - If ALL PASS: Type 1 (Best)
   - If ANY FAIL: Not Type 1, check Type 2

**4. Type 2 Analysis (Normal Stability)**:
   **{MainModel.BaseYear}:**
   - Current test: [PASS/FAIL] - A1+A2 = P1
   - Short-term test: [PASS/FAIL] - A1+A2 = P1+P2
   - Long-term test: [PASS/FAIL] - A1+A2 = P1+P2+P3
   - Status: [All 3 must pass for Type 2]
   
   **{MainModel.CurrentYear}:**
   - Current test: [PASS/FAIL]
   - Short-term test: [PASS/FAIL]
   - Long-term test: [PASS/FAIL]
   - Status: [All 3 must pass for Type 2]
   
   **Interpretation:**
   - If Type 1 failed AND Type 2 passes: Type 2 (Good)
   - If ANY FAIL: Not Type 2, check Type 3

**5. Type 3 Analysis (Pre-Crisis)**:
   **{MainModel.BaseYear}:**
   - Current test: [PASS/FAIL] - A1+A2+A3 = P1
   - Short-term test: [PASS/FAIL] - A1+A2+A3 = P1+P2
   - Long-term test: [PASS/FAIL] - A1+A2+A3 = P1+P2+P3
   - Status: [All 3 must pass for Type 3]
   
   **{MainModel.CurrentYear}:**
   - Current test: [PASS/FAIL]
   - Short-term test: [PASS/FAIL]
   - Long-term test: [PASS/FAIL]
   - Status: [All 3 must pass for Type 3]
   
   **Interpretation:**
   - If Type 1&2 failed AND Type 3 passes: Type 3 (Pre-crisis)
   - If ANY FAIL: Type 4 (Crisis)

**6. Type 4 Analysis (Crisis)**:
   **{MainModel.BaseYear}:**
   - Current test: [PASS/FAIL] - A1+A2+A3 < P1
   - Short-term test: [PASS/FAIL] - A1+A2+A3 < P1+P2
   - Long-term test: [PASS/FAIL] - A1+A2+A3 < P1+P2+P3
   - Status: [ANY test passing = Type 4]
   
   **{MainModel.CurrentYear}:**
   - Current test: [PASS/FAIL]
   - Short-term test: [PASS/FAIL]
   - Long-term test: [PASS/FAIL]
   - Status: [ANY test passing = Type 4]
   
   **Interpretation:**
   - If Types 1, 2, 3 ALL failed: Type 4 (CRISIS)
   - Cannot cover obligations from current assets
   - INSOLVENCY RISK

**7. What This Classification Means**:
   
   **If Type 1 (Absolute Stability):**
   • EXCELLENT
   • Can pay all obligations from cash alone
   • Maximum financial independence
   • Ultra-conservative capital structure
   • Minimal bankruptcy risk
   • May be over-capitalized
   • Opportunity: Could leverage for growth
   
   **If Type 2 (Normal Stability):**
   • GOOD
   • Liquid assets cover all obligations
   • Healthy, sustainable position
   • Good credit standing
   • Low bankruptcy risk
   • Normal operations
   • Action: Maintain position, monitor trends
   
   **If Type 3 (Pre-Crisis):**
   • RISKY
   • Dependent on inventory liquidation
   • Vulnerable to credit tightening
   • High refinancing risk
   • Medium-high bankruptcy risk
   • Pre-crisis warning signal
   • Action: Urgent improvement needed (Type 3 to Type 2)
   
   **If Type 4 (Crisis):**
   • CRITICAL
   • Cannot pay obligations from current assets
   • Insolvency risk imminent
   • CRITICAL bankruptcy risk
   • Emergency intervention required
   • Stakeholder concern warranted
   • Action: IMMEDIATE crisis management (Type 4 to Type 3 to Type 2)

**8. Trend Analysis and Consistency**:
   - Both years same type? [Yes/No]
   - If different: [Improving/Deteriorating]
   - Structural vs temporary classification
   - **Key questions:**
     • Consistent classification = Structural characteristic
     • Changing classification = Transitioning state
     • Which direction moving? (toward Type 1 or Type 4?)
     • Speed of change?

**9. Root Causes of Current Classification**:
   Explain WHY the company is in this type:
   
   **Financial factors:**
   • Cash position: [Strong/Weak]
   • Receivables quality: [Good/Poor]
   • Inventory levels: [Optimal/Excessive]
   • Current liabilities: [Manageable/Excessive]
   • Working capital: [Surplus/Deficit]
   
   **Operational factors:**
   • Business model characteristics
   • Industry norms
   • Growth phase
   • Capital structure decisions
   
   **Link to other tables:**
   • Current ratio (Table 14): [value]
   • Absolute liquidity (Table 14): [value]
   • Inventory funding (Table 15): [deficit/surplus]
   • Balance liquidity (Table 13): [Liquid/Illiquid]

**10. Strategic Recommendations**:
    
    **If Type 4 (CRISIS) - EMERGENCY ACTIONS:**
    
    • IMMEDIATE (30 days):
    • Emergency liquidity injection
    • Reduce current liabilities by [X]%
    • Increase liquid assets by [X]%
    • Negotiate payment extensions
    • Accelerate collections
    • Reduce inventory by 30-40%
    • Secure emergency credit line
    • Stakeholder communication
    • Target: Exit Type 4 immediately
    
    **30-90 Days Plan (Type 4 to Type 3):**
    • Build cash reserves
    • Stabilize payables
    • Optimize working capital
    • Ensure A1+A2+A3 = P1 (minimum)
    • Monitoring: Weekly liquidity reports
    
    **If Type 3 (PRE-CRISIS) - URGENT IMPROVEMENT:**
    
    • SHORT-TERM (3-6 months):
    • Increase liquid assets (A1+A2)
    • Reduce reliance on inventory
    • Strengthen cash position
    • Improve receivables collection
    • Optimize inventory levels
    • Target: Achieve Type 2 within 6-12 months
    
    **6-12 Months Plan (Type 3 to Type 2):**
    • Build working capital
    • Ensure A1+A2 = P1+P2+P3
    • Reduce short-term debt
    • Strengthen balance sheet
    
    **If Type 2 (NORMAL) - MAINTAIN & IMPROVE:**
    
    • MEDIUM-TERM (1-2 years):
    • Maintain healthy position
    • Monitor trends closely
    • Gradual improvement toward Type 1
    • Build equity through retained earnings
    • Optimize capital structure
    • Target: Consider Type 1 if appropriate
    
    **If Type 1 (ABSOLUTE) - OPTIMIZE:**
    
    • LONG-TERM:
    • Maintain conservative position OR
    • Consider strategic leverage for growth
    • Evaluate opportunity cost of excess cash
    • Balance independence vs ROE optimization
    
    **Universal Monitoring (All Types):**
    
    • Monthly KPIs:
    • Classification type (1, 2, 3, or 4)
    • All 12 test results (4 types × 3 perspectives)
    • Cash position (A1)
    • Liquid assets (A1+A2)
    • Current assets (A1+A2+A3)
    • Current liabilities (P1+P2+P3)
    • Working capital
    
    **Implementation Timeline:**
    • Type 4 to Type 3: 3-6 months (URGENT)
    • Type 3 to Type 2: 6-12 months (HIGH PRIORITY)
    • Type 2 to Type 1: 1-3 years (OPTIONAL)
    • Quarterly classification reviews
    • Early warning if type deteriorates

INTERPRETATION GUIDANCE:
- **Type 1 > Type 2 > Type 3 > Type 4** (Best to worst)
- **Type 4 = Emergency** (immediate action)
- **Type 3 = Warning** (urgent improvement)
- **Type 2 = Target** (sustainable position)
- **Type 1 = Ideal** (if appropriate for business)

CRITICAL INSIGHTS:
1. Which stability type is the company? (Final verdict)
2. Is classification consistent across periods?
3. Is company improving or deteriorating?
4. What are immediate implications?
5. If Type 4: How to exit crisis quickly?
6. If Type 3: How to achieve Type 2?
7. What's the path to sustainable stability?
8. Are stakeholders at risk?

SPECIAL CONSIDERATIONS:
- Type 4 = Bankruptcy risk, emergency actions
- Consistent Type 4 = Structural crisis, major restructuring needed
- Type 3 to Type 4 = Deteriorating, urgent reversal required
- Type 1 may indicate over-capitalization
- Classification consistency indicates structural vs temporary state

WRITING STYLE:
- Direct and clear
- Urgent if Type 4
- Risk-focused and consequence-driven
- Explain MEANING of classification
- Provide concrete improvement paths
- Be analytical but actionable

Write entire response in {languageInstruction}. DO NOT CREATE ANY TABLES. This is the FINAL VERDICT on financial stability - make it count!";
    }

    private void ClearAnalysis()
    {
        _aiAnalysis = string.Empty;
        _errorMessage = string.Empty;
    }

    private static string FormatAIResponse(string response)
    {
        if (string.IsNullOrWhiteSpace(response))
            return string.Empty;

        return response
            .Replace("\n\n", "<br/><br/>")
            .Replace("\n", "<br/>")
            .Replace("**", "<strong>")
            .Replace("**", "</strong>")
            .Replace("- ", "• ");
    }
}
