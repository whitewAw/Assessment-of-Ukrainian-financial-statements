@page "/assessmentofreceivableandpayable"
@using AFS.Core.Interfaces
@using AFS.Core.Services
@using AFS.ComponentLibrary.Helpers
@inject AssessmentOfReceivableAndPayable AssessmentOfReceivableAndPayable
@inject AfsModel AfsModel
@inject IAIFinancialAdvisor AIAdvisor
@implements IDisposable
@inject IJSRuntime JS

<RadzenCard Style="width: 100%;">
    <h2 class="text-center">@tableName</h2>
    <h5 class="text-end">(@ResLoc["thousandUAH"])</h5>
    <table class="table table-bordered py-0 table-sm table-striped">
        <thead>
            <tr>
                <ThComponent Rowspan=3>@ResLoc["NumberInOrder"]</ThComponent>
                <ThComponent Rowspan=3>@ResLoc["Settlements"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["AccountsReceivable"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["AccountsPayable"]</ThComponent>
                <ThComponent Colspan=4>@ResLoc["ExcessOfDebt"]</ThComponent>
            </tr>
            <tr>
                <ThComponent Rowspan=2>@MainModel.BaseYear  @ResLoc["year"]</ThComponent>
                <ThComponent Rowspan=2>@MainModel.CurrentYear  @ResLoc["year"]</ThComponent>
                <ThComponent Rowspan=2>@MainModel.BaseYear  @ResLoc["year"]</ThComponent>
                <ThComponent Rowspan=2>@MainModel.CurrentYear  @ResLoc["year"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["accounts"]</ThComponent>
                <ThComponent Colspan=2>@ResLoc["receivable"]</ThComponent>
            </tr>
            <tr>
                <ThComponent>@MainModel.BaseYear  @ResLoc["year"]</ThComponent>
                <ThComponent>@MainModel.CurrentYear  @ResLoc["year"]</ThComponent>
                <ThComponent>@MainModel.BaseYear  @ResLoc["year"]</ThComponent>
                <ThComponent>@MainModel.CurrentYear  @ResLoc["year"]</ThComponent>
            </tr>
        </thead>
        <tbody>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithBuyersOrSuppliers>
                @ResLoc["WithBuyersOrSuppliers"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithLongTermLiabilities>
                @ResLoc["WithLongTermLiabilities"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.ForBills>
                @ResLoc["ForBills"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.FromInsurance>
                @ResLoc["FromInsurance"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithBudgetAndExtraBudgetaryFunds>
                @ResLoc["WithBudgetAndExtraBudgetaryFunds"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithAccruedIncome>
                @ResLoc["WithAccruedIncome"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithPayroll>
                @ResLoc["WithPayroll"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithAdvances>
                @ResLoc["WithAdvances"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithParticipants>
                @ResLoc["WithParticipants"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithInternalCashSettlements>
                @ResLoc["WithInternalCashSettlements"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <TrAssessmentOfReceivableAndPayableComponent Item=AssessmentOfReceivableAndPayable.WithOther>
                @ResLoc["WithOther"]
            </TrAssessmentOfReceivableAndPayableComponent>
            <tr>
                <ThComponent TextAlignment="ML" Colspan=2>@ResLoc["Total"]</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.ReceivableBase)</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.ReceivableCurrent)</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.PayableBase)</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.PayableCurrent)</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.ExceedingReceivableBase)</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.ExceedingReceivableCurrent)</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.ExceedingPayableBase)</ThComponent>
                <ThComponent TextAlignment="MR" Spacing="pr-2">@AfsConstraints.RoundStr(AssessmentOfReceivableAndPayable.Total.ExceedingPayableCurrent)</ThComponent>
            </tr>
        </tbody>
    </table>
</RadzenCard>

@* @ResLoc["AIFinancialAnalysis"] Section *@
<RadzenCard Style="width: 100%; margin-top: 20px;">
    <h3 class="text-center mb-4">
        <i class="oi oi-brain me-2"></i>
        @ResLoc["AIFinancialAnalysis"]
    </h3>
    
    @if (_isCheckingAvailability)
    {
        <div class="d-flex justify-content-center mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span class="text-muted">@ResLoc["CheckingAIAvailability"]</span>
        </div>
    }
    else if (!_isAIAvailable)
    {
        <div class="alert alert-warning">
            <h6 class="alert-heading">
                <i class="oi oi-warning me-2"></i>
                @ResLoc["ChromeAINotAvailable"]
            </h6>
            <p class="mb-2">
                @ResLoc["ChromeAINotAvailableMessage"]
                <a href="/Assessment-of-Ukrainian-financial-statements/ai-assistant" class="alert-link">@ResLoc["AIAssistantPage"]</a>
                @ResLoc["ForSetupInstructions"]
            </p>
            <button class="btn btn-sm btn-primary" @onclick="CheckAIAvailability">
                <i class="oi oi-reload me-2"></i>
                @ResLoc["RecheckAvailability"]
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3">
            @if (_isAnalyzing)
            {
                <button class="btn btn-danger me-2" @onclick="StopAnalysis">
                    <i class="oi oi-media-stop me-2"></i>
                    <span>@ResLoc["StopAnalysis"]</span>
                </button>
            }
            else
            {
                <button class="btn btn-primary me-2" @onclick="AnalyzeReceivablePayable" disabled="@(!_isAIAvailable)">
                    <i class="oi oi-magnifying-glass me-2"></i>
                    <span>@ResLoc["AnalyzeReceivablesPayables"]</span>
                </button>
            }
            
            @if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAnalysis">
                    <i class="oi oi-x me-2"></i>
                    @ResLoc["Clear"]
                </button>
            }
        </div>

        @if (_isAnalyzing || !string.IsNullOrEmpty(_aiAnalysis))
        {
            <div class="alert alert-info">
                @if (_isAnalyzing && string.IsNullOrEmpty(_aiAnalysis))
                {
                    <div class="d-flex align-items-center">
                        <span class="typing-indicator me-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span class="text-muted">AI is analyzing receivables and payables...</span>
                    </div>
                }
                <div style="white-space: pre-wrap; line-height: 1.6;">
                    @((MarkupString)FormatAIResponse(_aiAnalysis))
                </div>
            </div>
        }
    }
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>@ResLoc["Error"]:</strong> @_errorMessage
        </div>
    }
</RadzenCard>

@code {
private CancellationTokenSource? _cts;
        private string? tableName;
    private string _aiAnalysis = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isAnalyzing = false;
    private bool _isCheckingAvailability = true;
    private bool _isAIAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();

        string name = ResLoc["AssessmentOfReceivableAndPayable"];
        int number = 11;

        tableName = String.Format("{0} {1}. {2} {3} {4}-{5} {6}", ResLoc["Table"], number, name, MainModel.CompanyName, MainModel.BaseYear, MainModel.CurrentYear, ResLoc["years"]);
        
        await CheckAIAvailability();
        
        await base.OnInitializedAsync();
    }

    private async Task CheckAIAvailability()
    {
        _isCheckingAvailability = true;
        StateHasChanged();

        _isAIAvailable = await AIAnalysisHelper.CheckAvailabilityAsync(AIAdvisor).ConfigureAwait(false);

        _isCheckingAvailability = false;
        StateHasChanged();
    }

    private async Task AnalyzeReceivablePayable()
    {
        if (!_isAIAvailable)
        {
            _errorMessage = "Chrome AI is not available. Please check the setup instructions.";
            return;
        }

        _isAnalyzing = true;
        _errorMessage = string.Empty;
        _aiAnalysis = string.Empty;
        StateHasChanged();

        try
        {
            var prompt = BuildReceivablePayablePrompt();

            await AIAdvisor.GetStreamingResponseAsync(prompt, chunk =>
            {
                _aiAnalysis += chunk;
                _ = InvokeAsync(StateHasChanged);
            }).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            var (appendText, errorMsg) = AIAnalysisHelper.HandleAnalysisException(ex, _aiAnalysis);
            if (appendText != null) _aiAnalysis += appendText;
            if (errorMsg != null) _errorMessage = errorMsg;
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task StopAnalysis()
    {
        await AIAnalysisHelper.StopAnalysisAsync(JS).ConfigureAwait(false);
        _isAnalyzing = false;
        StateHasChanged();
    }

    private string BuildReceivablePayablePrompt()
    {
        string languageInstruction = AfsConstraints.GetLanguageInstruction();

        // Use AOT-optimized JSON serialization
        var jsonData = JsonSerializationHelper.SerializeReceivablePayable(
            MainModel.CompanyName,
            MainModel.BaseYear,
            MainModel.CurrentYear,
            AssessmentOfReceivableAndPayable.Total,
            AssessmentOfReceivableAndPayable.WithBuyersOrSuppliers,
            AssessmentOfReceivableAndPayable.WithBudgetAndExtraBudgetaryFunds,
            AssessmentOfReceivableAndPayable.WithAdvances,
            AssessmentOfReceivableAndPayable.WithOther
        );

        return $@"You are a financial analyst specializing in working capital management, liquidity analysis, and credit risk assessment. Analyze the following Assessment of Receivable and Payable for {MainModel.CompanyName}.

IMPORTANT: Respond in {languageInstruction} language. The user interface is in {languageInstruction}, so your entire response must be in {languageInstruction}.

CRITICAL FORMATTING RULES:
- DO NOT create or display any tables
- DO NOT repeat raw data values in table format
- The user can see all data in the table above
- Focus on INTERPRETATION, INSIGHTS, and RECOMMENDATIONS
- Use narrative prose with clear sections and bullet points
- Reference numbers naturally in sentences

DATA STRUCTURE:
This table analyzes the BALANCE between what the company OWES (payables) and what is OWED TO the company (receivables) across 11 settlement categories for TWO YEARS ({MainModel.BaseYear} and {MainModel.CurrentYear}).

SETTLEMENT CATEGORIES:
1. With Buyers or Suppliers (Trade)
2. With Long-term Liabilities
3. Bills Receivable
4. From Insurance
5. With Budget and Off-Budget Funds (Taxes)
6. From Accrued Income
7. With Labor Payment (Salaries)
8. In Advances (Prepayments)
9. With Participants (Shareholders)
10. With Internal Settlements
11. With Others

NAMING CONVENTIONS:
- ""Accounts Receivable"" (money owed TO the company)
- ""Accounts Payable"" (money the company OWES)
- ""Excess Receivable"" (receivable > payable = net asset)
- ""Excess Payable"" (payable > receivable = net liability)
- ""Net Position"" (total receivable - total payable)

Financial Data ({MainModel.BaseYear}-{MainModel.CurrentYear}):
{jsonData}

KEY FORMULAS:
- Excess Receivable = Max(0, Receivable - Payable) for each category
- Excess Payable = Max(0, Payable - Receivable) for each category
- Net Position = Total Receivables - Total Payables
- Receivable-to-Payable Ratio = Total Receivables ÷ Total Payables

RESPONSE FORMAT:
- Professional narrative style
- Headings with ** (e.g., **1. Executive Summary**)
- Bullet points (•) for lists
- Numbers integrated into sentences
- NO tables or raw data dumps
- Focus on MEANING and LIQUIDITY IMPLICATIONS

ANALYSIS SECTIONS:

**1. Executive Summary - Receivables vs Payables Balance**:
   - 2-3 sentences on overall position
   - Primary finding: Net debtor or net creditor?
   - Key trend: Balance improving or deteriorating?
   - Liquidity verdict

**2. Total Receivables Analysis**:
   - {MainModel.BaseYear}: [amount] thousand UAH
   - {MainModel.CurrentYear}: [amount] thousand UAH
   - Change: [absolute] ([percentage]%)
   - Collection performance assessment
   - Receivable quality

**3. Total Payables Analysis**:
   - {MainModel.BaseYear}: [amount] thousand UAH
   - {MainModel.CurrentYear}: [amount] thousand UAH
   - Change: [absolute] ([percentage]%)
   - Payment obligations
   - Credit management

**4. Net Position Assessment - CRITICAL**:
   - Net Position = Receivables - Payables
   - {MainModel.BaseYear}: [amount] thousand UAH
   - {MainModel.CurrentYear}: [amount] thousand UAH
   - **Interpretation:**
     • POSITIVE = Net creditor (owed more than owing) ?
     • NEGATIVE = Net debtor (owing more than owed) ??
     • ZERO = Balanced
   - **Liquidity Impact:**
     • If negative: Must fund this gap from operations/credit
     • Direct working capital drain
     • Cash management critical

**5. Receivable-to-Payable Ratio**:
   - {MainModel.BaseYear}: [ratio]
   - {MainModel.CurrentYear}: [ratio]
   - **Benchmarks:**
     • >1.0 = More receivable (favorable position)
     • 1.0 = Balanced
     • <1.0 = More payable (net debtor) ??
   - Trend analysis

**6. Category-by-Category Analysis**:
   
   **Buyers/Suppliers (Trade - LARGEST):**
   - Receivable: [base] ? [current]
   - Payable: [base] ? [current]
   - Net: Excess [receivable/payable]
   - % of total: [percentage]
   - Trade credit analysis
   - Collection vs payment dynamics
   
   **Budget and Funds (Taxes):**
   - Receivable: [amount] (tax refunds)
   - Payable: [amount] (taxes owed)
   - Net: Usually receivable (favorable) ?
   - Government settlement timing
   
   **Advances (Prepayments):**
   - Receivable: Prepayments TO suppliers
   - Payable: Customer prepayments received
   - Net position assessment
   - Working capital tie-up
   
   **Others:**
   - Trend analysis
   - Cleanup of miscellaneous items
   - Risk assessment

**7. Cash Flow Implications**:
   - If all settlements occurred simultaneously:
     • Net cash inflow or outflow?
     • Amount: [net position]
   - **Working Capital Requirements:**
     • Must fund payable excess from where?
     • Credit line adequacy
   - Payment timing management

**8. Collection vs Payment Dynamics**:
   - Receivables declining faster/slower than payables?
   - **Possible scenarios:**
     • Both declining: Contraction
     • Receivables down, payables stable: Collection acceleration
     • Both growing: Expansion
   - Implications for cash management
   - Days Sales Outstanding vs Days Payable Outstanding trend

**9. Liquidity and Working Capital Assessment**:
   - Net position impact on liquidity
   - **If net debtor (negative position):**
     • Immediate funding need
     • Credit line requirements
     • Cash buffer necessity
   - **If net creditor (positive position):**
     • Cash collection strategy
     • Investment of excess funds
   - Trade credit leverage analysis

**10. Strategic Recommendations**:
    
    **Receivable Management:**
    • Accelerate collections if possible
    • Review credit terms with customers
    • Identify slow-paying customers
    • Consider factoring for large receivables
    • Target DSO reduction
    • Target receivable level: [specific amount]
    
    **Payable Management:**
    • Negotiate extended payment terms
    • Optimize payment timing (don't pay early)
    • Leverage supplier credit effectively
    • Don't damage relationships with late payment
    • Manage cash disbursements strategically
    • Target payable level: [specific amount]
    
    **Net Position Improvement:**
    • Current net position: [amount]
    • Target net position: [recommended amount]
    • Timeline: [12-18 months]
    • **Methods:**
      - If net debtor: Increase collections, extend payables
      - If net creditor: Maintain favorable position
      - Balance growth with liquidity
    
    **By Category Priorities:**
    1. **Buyers/Suppliers:** [specific actions - largest impact]
    2. **Budget/Funds:** [maintain/accelerate tax refunds]
    3. **Advances:** [reduce/optimize prepayments]
    4. **Others:** [clean up miscellaneous items]
    
    **Cash Management:**
    • Forecast settlement funding need: [amount]
    • Ensure adequate credit lines: [recommended amount]
    • Monitor payment cycles closely
    • Optimize working capital daily
    • Weekly cash flow forecasting
    
    **Working Capital Targets:**
    • Receivable-to-Payable Ratio: Target >0.90
    • Net Position: Target <5M excess payable
    • DSO (Days Sales Outstanding): Target [X days]
    • DPO (Days Payable Outstanding): Target [Y days]
    
    **Implementation Timeline:**
    • Immediate (30 days):
      - Cash forecast & credit line review
      - Identify collection opportunities
      - Assess payment obligations
    
    • Short-term (3-6 months):
      - Collection acceleration program
      - Payment term negotiations
      - Working capital optimization
    
    • Long-term (1-2 years):
      - Structural improvement in net position
      - Sustainable working capital model
      - Target net position achievement

INTERPRETATION GUIDANCE:
- Net Position: POSITIVE is better (net creditor)
- Receivable-to-Payable Ratio: HIGHER is better (>1.0 ideal)
- Excess Receivable: Asset (will receive cash)
- Excess Payable: Liability (must pay cash)

CRITICAL INSIGHTS:
1. Is the company a net debtor or net creditor?
2. Is the net position improving or deteriorating?
3. What's the receivable-to-payable ratio trend?
4. Which category dominates the imbalance?
5. What's the cash flow impact of settlements?
6. Is working capital being managed effectively?
7. Are there liquidity risks from excess payables?
8. What's the optimal net position target?

SPECIAL CONSIDERATIONS:
- Trade receivables/payables typically largest
- Tax receivables usually favorable (refunds)
- Advances can tie up working capital
- Timing mismatches create cash flow issues
- Net debtor position = funding requirement

WRITING STYLE:
- Direct and professional
- Active voice
- Integrate numbers naturally
- Explain WHY balance matters for liquidity
- Provide cash management context
- Be analytical and actionable

All amounts in thousand UAH. Write entire response in {languageInstruction}. DO NOT CREATE ANY TABLES.";
    }

    private void ClearAnalysis()
    {
        _aiAnalysis = string.Empty;
        _errorMessage = string.Empty;
    }

    private static string FormatAIResponse(string response) => AIAnalysisHelper.FormatResponse(response);

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
