@page "/sourcesofcapitalformation"
@using AFS.Core.Interfaces
@using AFS.Core.Services
@using AFS.ComponentLibrary.Helpers
@inject SourcesOfCapitalFormation SourcesOfCapitalFormation
@inject AfsModel AfsModel
@inject IAIFinancialAdvisor AIAdvisor
@implements IDisposable
@inject IJSRuntime JS

<SeoHead Title="Sources of Capital Formation | UFIN"
         Description="Breakdown of equity, long-term debt, short-term debt and retained earnings as funding sources from a Ukrainian balance sheet." />

<RadzenCard Style="width: 100%;">
    <h2 class="text-center">@tableName</h2>
    <h5 class="text-end">(@ResLoc["thousandUAH"])</h5>
    <table class="table table-bordered py-0 table-sm table-striped">
        <THeadTwoYearsDetail />
        <tbody>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.TotalSourcesOfCapital.Base
                                                      Current=@SourcesOfCapitalFormation.TotalSourcesOfCapital.Current Colspan=2 FieldName=@ResLoc["TotalSourcesOfCapital"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.Equity.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.Equity.Base
                                                      Current=@SourcesOfCapitalFormation.Equity.Current FieldName=@ResLoc["Equity"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.Equity.InPercentageOfAssetsBase
                                                      Current=@SourcesOfCapitalFormation.Equity.InPercentageOfAssetsCurrent IsShowGrowthRate="false" FieldName=@ResLoc["in%toSourcesOfCapital"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.OwnCurrentAssets.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.OwnCurrentAssets.Base
                                                      Current=@SourcesOfCapitalFormation.OwnCurrentAssets.Current Spacing="pl-3" FieldName=@ResLoc["OwnCurrentAssets"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.OwnCurrentAssets.InPercentageOfEquityBase
                                                      Current=@SourcesOfCapitalFormation.OwnCurrentAssets.InPercentageOfEquityCurrent IsShowGrowthRate="false" Spacing="pl-3" FieldName=@ResLoc["in%ToEquity"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.RaisedCapital.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.RaisedCapital.Base
                                                      Current=@SourcesOfCapitalFormation.RaisedCapital.Current FieldName=@ResLoc["RaisedCapital"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.RaisedCapital.InPercentageOfAssetsBase
                                                      Current=@SourcesOfCapitalFormation.RaisedCapital.InPercentageOfAssetsCurrent IsShowGrowthRate="false" FieldName=@ResLoc["in%toSourcesOfCapital"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.LongTermLiabilities.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.LongTermLiabilities.Base
                                                      Current=@SourcesOfCapitalFormation.LongTermLiabilities.Current Spacing="pl-3" FieldName=@ResLoc["LongTermLiabilities_"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.LongTermLiabilities.InPercentageOfBorrowedCapitalBase
                                                      Current=@SourcesOfCapitalFormation.LongTermLiabilities.InPercentageOfBorrowedCapitalCurrent IsShowGrowthRate="false" Spacing="pl-3" FieldName=@ResLoc["in%OfBorrowedCapital"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.ShortTermLoans.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.ShortTermLoans.Base
                                                      Current=@SourcesOfCapitalFormation.ShortTermLoans.Current Spacing="pl-3" FieldName=@ResLoc["ShortTermLoans"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.ShortTermLoans.InPercentageOfBorrowedCapitalBase
                                                      Current=@SourcesOfCapitalFormation.ShortTermLoans.InPercentageOfBorrowedCapitalCurrent IsShowGrowthRate="false" Spacing="pl-3" FieldName=@ResLoc["in%OfBorrowedCapital"] />
            </tr>

            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.AccountsPayable.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.AccountsPayable.Base
                                                      Current=@SourcesOfCapitalFormation.AccountsPayable.Current Spacing="pl-3" FieldName=@ResLoc["AccountsPayable"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.AccountsPayable.InPercentageOfBorrowedCapitalBase
                                                      Current=@SourcesOfCapitalFormation.AccountsPayable.InPercentageOfBorrowedCapitalCurrent IsShowGrowthRate="false" Spacing="pl-3" FieldName=@ResLoc["in%OfBorrowedCapital"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.OtherCurrentLiabilities.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.OtherCurrentLiabilities.Base
                                                      Current=@SourcesOfCapitalFormation.OtherCurrentLiabilities.Current Spacing="pl-3" FieldName=@ResLoc["OtherCurrentLiabilities"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.OtherCurrentLiabilities.InPercentageOfBorrowedCapitalBase
                                                      Current=@SourcesOfCapitalFormation.OtherCurrentLiabilities.InPercentageOfBorrowedCapitalCurrent IsShowGrowthRate="false" Spacing="pl-3" FieldName=@ResLoc["in%OfBorrowedCapital"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.LiabilitiesRelatedNonCurrentAssetsHeldForSale.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.LiabilitiesRelatedNonCurrentAssetsHeldForSale.Base
                                                      Current=@SourcesOfCapitalFormation.LiabilitiesRelatedNonCurrentAssetsHeldForSale.Current Spacing="pl-3" FieldName=@ResLoc["LiabilitiesRelatedNonCurrentAssetsHeldForSale"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.LiabilitiesRelatedNonCurrentAssetsHeldForSale.InPercentageOfBorrowedCapitalBase
                                                      Current=@SourcesOfCapitalFormation.LiabilitiesRelatedNonCurrentAssetsHeldForSale.InPercentageOfBorrowedCapitalCurrent IsShowGrowthRate="false" Spacing="pl-3" FieldName=@ResLoc["in%OfBorrowedCapital"] />
            </tr>
            <tr>
                <TdComponent Rowspan="2" TextAlignment="ML">@SourcesOfCapitalFormation.FutureIncome.Number</TdComponent>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.FutureIncome.Base
                                                      Current=@SourcesOfCapitalFormation.FutureIncome.Current FieldName=@ResLoc["FutureIncome"] />
            </tr>
            <tr>
                <TdsCharacteristicsOfCapitalComponent Base=@SourcesOfCapitalFormation.FutureIncome.InPercentageOfAssetsBase
                                                      Current=@SourcesOfCapitalFormation.FutureIncome.InPercentageOfAssetsCurrent IsShowGrowthRate="false" FieldName=@ResLoc["in%toSourcesOfCapital"] />
            </tr>
        </tbody>
    </table>
</RadzenCard>

@* @ResLoc["AIFinancialAnalysis"] Section *@
<RadzenCard Style="width: 100%; margin-top: 20px;">
    <h3 class="text-center mb-4">
        <i class="oi oi-brain me-2"></i>
        @ResLoc["AIFinancialAnalysis"]
    </h3>
    
    @if (_isCheckingAvailability)
    {
        <div class="d-flex justify-content-center mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span class="text-muted">@ResLoc["CheckingAIAvailability"]</span>
        </div>
    }
    else if (!_isAIAvailable)
    {
        <div class="alert alert-warning">
            <h6 class="alert-heading">
                <i class="oi oi-warning me-2"></i>
                @ResLoc["ChromeAINotAvailable"]
            </h6>
            <p class="mb-2">
                @ResLoc["ChromeAINotAvailableMessage"]
                <a href="/Assessment-of-Ukrainian-financial-statements/ai-assistant" class="alert-link">@ResLoc["AIAssistantPage"]</a>
                @ResLoc["ForSetupInstructions"]
            </p>
            <button class="btn btn-sm btn-primary" @onclick="CheckAIAvailability">
                <i class="oi oi-reload me-2"></i>
                @ResLoc["RecheckAvailability"]
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3">
            @if (_isAnalyzing)
            {
                <button class="btn btn-danger me-2" @onclick="StopAnalysis">
                    <i class="oi oi-media-stop me-2"></i>
                    <span>@ResLoc["StopAnalysis"]</span>
                </button>
            }
            else
            {
                <button class="btn btn-primary me-2" @onclick="AnalyzeCapitalStructure" disabled="@(!_isAIAvailable)">
                    <i class="oi oi-magnifying-glass me-2"></i>
                    <span>@ResLoc["AnalyzeCapitalSources"]</span>
                </button>
            }
            
            @if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAnalysis">
                    <i class="oi oi-x me-2"></i>
                    @ResLoc["Clear"]
                </button>
            }
        </div>

        @if (_isAnalyzing || !string.IsNullOrEmpty(_aiAnalysis))
        {
            <div class="alert alert-info">
                @if (_isAnalyzing && string.IsNullOrEmpty(_aiAnalysis))
                {
                    <div class="d-flex align-items-center">
                        <span class="typing-indicator me-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span class="text-muted">AI is analyzing capital structure...</span>
                    </div>
                }
                <div style="white-space: pre-wrap; line-height: 1.6;">
                    @((MarkupString)FormatAIResponse(_aiAnalysis))
                </div>
            </div>
        }
    }
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>@ResLoc["Error"]:</strong> @_errorMessage
        </div>
    }
</RadzenCard>

@code {
private CancellationTokenSource? _cts;
        private string? tableName;
    private string _aiAnalysis = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isAnalyzing = false;
    private bool _isCheckingAvailability = true;
    private bool _isAIAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();

        string name = ResLoc["SourcesOfCapitalFormation"];
        int number = 10;

        tableName = String.Format("{0} {1}. {2} {3} {4}-{5} {6}", ResLoc["Table"], number, name, MainModel.CompanyName, MainModel.BaseYear, MainModel.CurrentYear, ResLoc["years"]);
        
        // Check AI availability on page load
        await CheckAIAvailability();
        
        await base.OnInitializedAsync();
    }

    private async Task CheckAIAvailability() { _isCheckingAvailability = true; StateHasChanged(); _isAIAvailable = await AIAnalysisHelper.CheckAvailabilityAsync(AIAdvisor).ConfigureAwait(false); _isCheckingAvailability = false; StateHasChanged(); }

    private async Task AnalyzeCapitalStructure()
    {
        if (!_isAIAvailable)
        {
            _errorMessage = "Chrome AI is not available. Please check the setup instructions.";
            return;
        }

        _isAnalyzing = true;
        _errorMessage = string.Empty;
        _aiAnalysis = string.Empty;
        StateHasChanged();

        try
        {
            var prompt = BuildCapitalStructurePrompt();
            
            await AIAdvisor.GetStreamingResponseAsync(prompt, chunk =>
            {
                _aiAnalysis += chunk;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("cancelled") || ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrEmpty(_aiAnalysis))
                {
                    _aiAnalysis += "\n\n[Analysis stopped by user]";
                }
                else
                {
                    _errorMessage = "Analysis was stopped by user.";
                }
            }
            else
            {
                _errorMessage = $"Failed to analyze data: {ex.Message}";
            }
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task StopAnalysis() { await AIAnalysisHelper.StopAnalysisAsync(JS).ConfigureAwait(false); _isAnalyzing = false; StateHasChanged(); }

    private string BuildCapitalStructurePrompt()
    {
        string languageInstruction = AfsConstraints.GetLanguageInstruction();

        // Use AOT-optimized JSON serialization
        var jsonData = JsonSerializationHelper.SerializeSourcesOfCapital(
            MainModel.CompanyName,
            MainModel.BaseYear,
            MainModel.CurrentYear,
            SourcesOfCapitalFormation.TotalSourcesOfCapital,
            SourcesOfCapitalFormation.Equity,
            SourcesOfCapitalFormation.OwnCurrentAssets,
            SourcesOfCapitalFormation.RaisedCapital,
            SourcesOfCapitalFormation.LongTermLiabilities,
            SourcesOfCapitalFormation.ShortTermLoans,
            SourcesOfCapitalFormation.AccountsPayable,
            SourcesOfCapitalFormation.OtherCurrentLiabilities
        );

        return $@"You are a financial analyst specializing in capital structure, financial leverage, and corporate finance. Analyze the following Sources of Capital Formation for {MainModel.CompanyName}.

IMPORTANT: Respond in {languageInstruction} language. The user interface is in {languageInstruction}, so your entire response must be in {languageInstruction}.

CRITICAL FORMATTING RULES:
- DO NOT create or display any tables
- DO NOT repeat raw data values in table format
- The user can see all data in the table above
- Focus on INTERPRETATION, INSIGHTS, and RECOMMENDATIONS
- Use narrative prose with clear sections and bullet points
- Reference numbers naturally in sentences

DATA STRUCTURE:
You are analyzing FOUR data points per metric (2 years × 2 time points):
- {MainModel.BaseYear} Beginning and End
- {MainModel.CurrentYear} Beginning and End

This table shows CAPITAL STRUCTURE - how the company finances its operations.

CAPITAL HIERARCHY:
Total Capital Sources (100%)
+- 1. Equity (Own Capital) + % of Total
¦  +- 1.1 Own Current Assets + % of Equity
+- 2. Borrowed Capital + % of Total
¦  +- 2.1 Long-term Liabilities + % of Debt
¦  +- 2.2 Short-term Loans + % of Debt
¦  +- 2.3 Accounts Payable + % of Debt
¦  +- 2.4 Other Current Liabilities + % of Debt
¦  +- 2.5 Liabilities for Assets Held for Sale
+- 3. Future Period Income

NAMING CONVENTIONS:
Use proper names:
- ""Equity"" or ""Shareholders' Equity"" (not ""Own Capital"")
- ""Borrowed Capital"" or ""Total Debt"" (not ""Raised Capital"")
- ""Accounts Payable"" (supplier credit)
- ""Own Current Assets"" (working capital from equity)

Financial Data ({MainModel.BaseYear}-{MainModel.CurrentYear}):
{jsonData}

KEY FORMULAS:
- Equity Ratio = Equity ÷ Total Capital × 100
- Debt Ratio = Borrowed Capital ÷ Total Capital × 100
- Equity-to-Debt Ratio = Equity ÷ Borrowed Capital
- Financial Leverage = Total Capital ÷ Equity

RESPONSE FORMAT:
- Professional narrative style
- Headings with ** (e.g., **1. Executive Summary**)
- Bullet points (•) for lists
- Numbers integrated into sentences
- NO tables or raw data dumps
- Focus on MEANING

ANALYSIS SECTIONS:

**1. Executive Summary - Capital Structure Verdict**:
   - 2-3 sentences on overall capital structure
   - Primary finding: Financial independence or over-leveraged?
   - Key trend: Equity increasing or decreasing?
   - Quick verdict on financial health

**2. Total Capital Sources Analysis**:
   - Total funding trend
   - {MainModel.BaseYear}: Begin vs End
   - {MainModel.CurrentYear}: Begin vs End
   - Capital adequacy assessment
   - Growth or contraction interpretation

**3. Equity (Shareholders' Equity) Analysis**:
   - Equity level and trend
   - {MainModel.BaseYear} End: [amount] ([percent]% of capital)
   - {MainModel.CurrentYear} End: [amount] ([percent]% of capital)
   - **Interpretation:**
     • >50% = Strong financial independence ?
     • 40-50% = Balanced, healthy
     • 30-40% = Moderate leverage
     • <30% = High leverage, risky
   - Trend: improving or deteriorating?

**4. Own Current Assets Analysis - CRITICAL**:
   - {MainModel.BaseYear}: [amount] ([percent]% of equity)
   - {MainModel.CurrentYear}: [amount] ([percent]% of equity)
   - **Interpretation:**
     • Positive & Large = Equity finances working capital (conservative) ?
     • Near Zero = Equity covers only fixed assets (balanced)
     • NEGATIVE = Working capital ENTIRELY from debt (risky) 
   - **This metric reveals HOW working capital is financed**
   - Assessment and implications

**5. Borrowed Capital Analysis**:
   - Total debt and trend
   - {MainModel.BaseYear} End: [amount] ([percent]% of capital)
   - {MainModel.CurrentYear} End: [amount] ([percent]% of capital)
   - **Interpretation:**
     • <50% = Conservative, low risk 
     • 50-60% = Moderate leverage
     • 60-70% = Aggressive leverage
     • >70% = High risk 
   - Debt reliance assessment

**6. Equity vs Debt Balance**:
   - Calculate Equity-to-Debt Ratio for both years
   - {MainModel.BaseYear}: Equity/Debt = [ratio]
   - {MainModel.CurrentYear}: Equity/Debt = [ratio]
   - **Benchmarks:**
     • >1.0 = More equity than debt (conservative)
     • 0.5-1.0 = Balanced
     • <0.5 = Debt heavy (risky)
   - Optimal capital structure assessment

**7. Debt Component Decomposition**:
   
   **Long-term Liabilities:**
   - [amount] thousand UAH ([percent]% of debt)
   - Strategic debt for investments
   - Maturity structure
   
   **Short-term Loans:**
   - [amount] thousand UAH ([percent]% of debt)
   - Operating credit lines
   - Usually minimal
   
   **Accounts Payable (KEY):**
   - [amount] thousand UAH ([percent]% of debt)
   - Supplier credit = FREE financing ?
   - Typically largest component
   - Payment terms assessment
   
   **Other Current Liabilities:**
   - [amount] thousand UAH ([percent]% of debt)
   - Accrued expenses, taxes
   
   **Which component dominates? Is this optimal?**

**8. Debt Maturity Profile**:
   - Long-term vs Short-term debt ratio
   - Maturity balance assessment
   - **Risks:**
     • Too much short-term = Refinancing risk
     • All long-term = Higher cost
   - Optimal maturity mix recommendation

**9. Capital Structure Evolution**:
   - Four-point trend analysis
   - Intra-year changes (within each year)
   - Inter-year changes (2019 vs 2020)
   - **Identify trend:**
     • Increasing leverage?
     • Deleveraging?
     • Stable structure?
   - Financial strategy assessment

**10. Strategic Recommendations**:
    
    **Capital Structure Optimization:**
    • Target equity % (recommend 40-50%)
    • Target debt % (recommend 50-60%)
    • Optimal leverage level
    
    **If Equity is LOW (<30%):**
    • Retain earnings instead of dividends
    • Consider equity injection
    • Reduce debt where possible
    • Target: 40% equity within 2 years
    
    **If Debt is HIGH (>70%):**
    • Debt reduction priority
    • Refinancing opportunities
    • Asset sales if needed
    • Target: <60% debt
    
    **Own Current Assets Strategy:**
    • If NEGATIVE: Increase equity for working capital
    • Target: At least break-even
    • Reduce fixed asset investments temporarily
    • Build equity buffer
    
    **Debt Composition Optimization:**
    • Maximize Accounts Payable (free credit)
    • Extend payment terms with suppliers
    • Minimize costly bank loans
    • Balance long-term vs short-term
    
    **Working Capital Financing:**
    • How much from equity vs debt?
    • Optimal mix for liquidity
    • Credit line management
    
    **Implementation Timeline:**
    • Immediate (30 days): [specific actions]
    • Short-term (3-6 months): [tactical changes]
    • Long-term (1-2 years): [strategic transformation]
    • Quarterly monitoring: [key metrics]

INTERPRETATION GUIDANCE:
- Equity %: HIGHER is better (financial independence)
- Debt %: LOWER is better (less risk)
- Own Current Assets: POSITIVE is better (equity covers working capital)
- Accounts Payable %: HIGHER is good (free financing)
- Equity-to-Debt Ratio: HIGHER is more conservative

CRITICAL INSIGHTS:
1. Is the company financially independent or over-leveraged?
2. Is equity % increasing (good) or decreasing (bad)?
3. Is working capital funded by equity or debt?
4. What's the debt composition? (long-term vs short-term, AP vs loans)
5. Is Accounts Payable being used effectively?
6. Are there refinancing risks?
7. What's the optimal capital structure target?
8. Should the company raise equity or reduce debt?

WRITING STYLE:
- Direct and professional
- Active voice
- Integrate numbers naturally
- Explain WHY changes matter
- Provide strategic context
- Be analytical and actionable

All amounts in thousand UAH. Write entire response in {languageInstruction}. DO NOT CREATE ANY TABLES.";
    }

    private void ClearAnalysis()
    {
        _aiAnalysis = string.Empty;
        _errorMessage = string.Empty;
    }

    private static string FormatAIResponse(string response) => AIAnalysisHelper.FormatResponse(response);

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
