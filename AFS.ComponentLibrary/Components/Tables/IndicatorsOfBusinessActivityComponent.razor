@page "/indicatorsofbusinessactivity"
@using AFS.Core.Interfaces
@using AFS.Core.Services
@inject IndicatorsOfBusinessActivity IndicatorsOfBusinessActivity
@inject AFSModel AFSModel
@inject IAIFinancialAdvisor AIAdvisor
@inject IJSRuntime JS

<RadzenCard Style="width: 100%;">
    <h2 class="text-center">@tableName</h2>
    <table class="table table-bordered py-0 table-sm table-striped">
        <THeadCommonComponent />
        <tbody>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.GrossProfitPerSoldProducts Digits=2>@ResLoc["GrossProfitPerSoldProducts"], @ResLoc["currency"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.CoefficientOfBusinessActivity Digits=2 IsShowGrowthRate=false>@ResLoc["CoefficientOfBusinessActivity"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.CoefficientOfEfficiencFinancialResources Digits=2 IsShowGrowthRate=false>@ResLoc["CoefficientOfEfficiencFinancialResources"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.CoefficientOfOwnFundsUtilization Digits=2 IsShowGrowthRate=false>@ResLoc["CoefficientOfOwnFundsUtilization"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.ProfitabilityRatioOfEnterprise Digits=2 IsShowGrowthRate=false>@ResLoc["ProfitabilityRatioOfEnterprise"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.ProductivityOfOneAverageEmployee Digits=2>@ResLoc["LaborProductivity"], @ResLoc["thousandUAH"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.ReturnOnFixedAssets Digits=2>@ResLoc["ReturnOnFixedAssets"], @ResLoc["currency"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.RevolutionsFromReceivables Digits=2>@ResLoc["TurnoverInSettlements"], @ResLoc["revolutions"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.ReceivablesTurnover Digits=2>@ResLoc["TurnoverInSettlements"], @ResLoc["days"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.TurnoverOfInventoriesRevolutions Digits=2>@ResLoc["TurnoverOfInventories"], @ResLoc["revolutions"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.TurnoverOfInventoriesDays Digits=2>@ResLoc["TurnoverOfInventories"], @ResLoc["days"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.OperatingCycleDuration Digits=2>@ResLoc["OperatingCycleDuration"], @ResLoc["days"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.NumberOfRevolutionsOfCurrentAssets Digits=2>@ResLoc["TurnoverOfCurrentAssets"], @ResLoc["revolutions"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.TurnoverOfWorkingCapital Digits=2>@ResLoc["TurnoverOfCurrentAssets"], @ResLoc["days"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.TurnoverOfEquity Digits=2>@ResLoc["TurnoverOfEquity"], @ResLoc["revolutions"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.TurnoverOfTotalCapital Digits=2>@ResLoc["TurnoverOfTotalCapital"], @ResLoc["revolutions"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.CoefficientOfStabilityOfEconomicGrowth Digits=2 IsShowGrowthRate=false>@ResLoc["CoefficientOfStabilityOfEconomicGrowth"]</TrTwoYearsCalculationDataComponent>
            <TrTwoYearsCalculationDataComponent Item=@IndicatorsOfBusinessActivity.ReturnOnEquityPeriod Digits=2>@ResLoc["ReturnOnEquityPeriod"], @ResLoc["years"]</TrTwoYearsCalculationDataComponent>
        </tbody>
    </table>
</RadzenCard>

@* @ResLoc["AIFinancialAnalysis"] Section *@
<RadzenCard Style="width: 100%; margin-top: 20px;">
    <h3 class="text-center mb-4">
        <i class="oi oi-brain me-2"></i>
        @ResLoc["AIFinancialAnalysis"]
    </h3>
    
    @if (_isCheckingAvailability)
    {
        <div class="d-flex justify-content-center mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span class="text-muted">@ResLoc["CheckingAIAvailability"]</span>
        </div>
    }
    else if (!_isAIAvailable)
    {
        <div class="alert alert-warning">
            <h6 class="alert-heading">
                <i class="oi oi-warning me-2"></i>
                @ResLoc["ChromeAINotAvailable"]
            </h6>
            <p class="mb-2">
                @ResLoc["ChromeAINotAvailableMessage"]
                <a href="/Assessment-of-Ukrainian-financial-statements/ai-assistant" class="alert-link">@ResLoc["AIAssistantPage"]</a>
                @ResLoc["ForSetupInstructions"]
            </p>
            <button class="btn btn-sm btn-primary" @onclick="CheckAIAvailability">
                <i class="oi oi-reload me-2"></i>
                @ResLoc["RecheckAvailability"]
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3">
            @if (_isAnalyzing)
            {
                <button class="btn btn-danger me-2" @onclick="StopAnalysis">
                    <i class="oi oi-media-stop me-2"></i>
                    <span>@ResLoc["StopAnalysis"]</span>
                </button>
            }
            else
            {
                <button class="btn btn-primary me-2" @onclick="AnalyzeBusinessActivity" disabled="@(!_isAIAvailable)">
                    <i class="oi oi-magnifying-glass me-2"></i>
                    <span>@ResLoc["AnalyzeBusinessActivity"]</span>
                </button>
            }
            
            @if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAnalysis">
                    <i class="oi oi-x me-2"></i>
                    @ResLoc["Clear"]
                </button>
            }
        </div>

        @if (_isAnalyzing || !string.IsNullOrEmpty(_aiAnalysis))
        {
            <div class="alert alert-info">
                @if (_isAnalyzing && string.IsNullOrEmpty(_aiAnalysis))
                {
                    <div class="d-flex align-items-center">
                        <span class="typing-indicator me-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span class="text-muted">AI is analyzing business activity indicators...</span>
                    </div>
                }
                <div style="white-space: pre-wrap; line-height: 1.6;">
                    @((MarkupString)FormatAIResponse(_aiAnalysis))
                </div>
            </div>
        }
    }
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>@ResLoc["Error"]:</strong> @_errorMessage
        </div>
    }
</RadzenCard>

<style>
    .typing-indicator {
        display: inline-flex;
        gap: 4px;
        align-items: center;
    }

    .typing-indicator span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #0056b3;
        animation: bounce 1.4s infinite ease-in-out;
        display: inline-block;
    }

    .typing-indicator span:nth-child(1) {
        animation-delay: -0.32s;
    }

    .typing-indicator span:nth-child(2) {
        animation-delay: -0.16s;
    }

    @@keyframes bounce {
        0%, 80%, 100% {
            transform: scale(0);
        }
        40% {
            transform: scale(1);
        }
    }
</style>

@code {
    private string? tableName;
    private string _aiAnalysis = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isAnalyzing = false;
    private bool _isCheckingAvailability = true;
    private bool _isAIAvailable = false;
    private string _availabilityMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        string name = ResLoc["IndicatorsOfBusinessActivity"];
        int number = 12;

        tableName = String.Format("{0} {1}. {2} {3} {4}-{5} {6}", ResLoc["Table"], number, name, MainModel.CompanyName, MainModel.BaseYear, MainModel.CurrentYear, ResLoc["years"]);
        
        await CheckAIAvailability();
        
        base.OnInitialized();
    }

    private async Task CheckAIAvailability()
    {
        _isCheckingAvailability = true;
        StateHasChanged();

        try
        {
            var (isAvailable, message) = await AIAdvisor.CheckAvailabilityAsync();
            _isAIAvailable = isAvailable;
            _availabilityMessage = message;
        }
        catch (Exception ex)
        {
            _isAIAvailable = false;
            _availabilityMessage = $"Error checking AI availability: {ex.Message}";
        }
        finally
        {
            _isCheckingAvailability = false;
            StateHasChanged();
        }
    }

    private async Task AnalyzeBusinessActivity()
    {
        if (!_isAIAvailable)
        {
            _errorMessage = "Chrome AI is not available. Please check the setup instructions.";
            return;
        }

        _isAnalyzing = true;
        _errorMessage = string.Empty;
        _aiAnalysis = string.Empty;
        StateHasChanged();

        try
        {
            var prompt = BuildBusinessActivityPrompt();
            
            await AIAdvisor.GetStreamingResponseAsync(prompt, chunk =>
            {
                _aiAnalysis += chunk;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("cancelled") || ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrEmpty(_aiAnalysis))
                {
                    _aiAnalysis += "\n\n[Analysis stopped by user]";
                }
                else
                {
                    _errorMessage = "Analysis was stopped by user.";
                }
            }
            else
            {
                _errorMessage = $"Failed to analyze data: {ex.Message}";
            }
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task StopAnalysis()
    {
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chromeai.js");
            await module.InvokeVoidAsync("abortCurrentOperation");
            
            if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                _aiAnalysis += "\n\n[Analysis stopped by user]";
            }
            
            _isAnalyzing = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping analysis: {ex.Message}");
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private string BuildBusinessActivityPrompt()
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture;
        var cultureName = currentCulture.Name;
        
        string languageInstruction = cultureName.StartsWith("uk") 
            ? "Ukrainian" 
            : cultureName.StartsWith("en") 
            ? "English" 
            : currentCulture.EnglishName;

        // Use AOT-optimized JSON serialization
        var jsonData = JsonSerializationHelper.SerializeBusinessActivity(
            MainModel.CompanyName,
            MainModel.BaseYear,
            MainModel.CurrentYear,
            IndicatorsOfBusinessActivity.GrossProfitPerSoldProducts,
            IndicatorsOfBusinessActivity.CoefficientOfBusinessActivity,
            IndicatorsOfBusinessActivity.CoefficientOfEfficiencFinancialResources,
            IndicatorsOfBusinessActivity.CoefficientOfOwnFundsUtilization,
            IndicatorsOfBusinessActivity.ProfitabilityRatioOfEnterprise,
            IndicatorsOfBusinessActivity.ProductivityOfOneAverageEmployee,
            IndicatorsOfBusinessActivity.ReturnOnFixedAssets,
            IndicatorsOfBusinessActivity.RevolutionsFromReceivables,
            IndicatorsOfBusinessActivity.ReceivablesTurnover,
            IndicatorsOfBusinessActivity.TurnoverOfInventoriesRevolutions,
            IndicatorsOfBusinessActivity.TurnoverOfInventoriesDays,
            IndicatorsOfBusinessActivity.OperatingCycleDuration,
            IndicatorsOfBusinessActivity.NumberOfRevolutionsOfCurrentAssets,
            IndicatorsOfBusinessActivity.TurnoverOfWorkingCapital,
            IndicatorsOfBusinessActivity.TurnoverOfEquity,
            IndicatorsOfBusinessActivity.TurnoverOfTotalCapital,
            IndicatorsOfBusinessActivity.CoefficientOfStabilityOfEconomicGrowth,
            IndicatorsOfBusinessActivity.ReturnOnEquityPeriod
        );

        return $@"You are a financial analyst specializing in business activity analysis, operational efficiency, and performance measurement. Analyze the following Indicators of Business Activity for {MainModel.CompanyName}.

IMPORTANT: Respond in {languageInstruction} language. The user interface is in {languageInstruction}, so your entire response must be in {languageInstruction}.

CRITICAL FORMATTING RULES:
- DO NOT create or display any tables
- DO NOT repeat raw data values in table format
- The user can see all data in the table above
- Focus on INTERPRETATION, INSIGHTS, and RECOMMENDATIONS
- Use narrative prose with clear sections and bullet points
- Reference numbers naturally in sentences

DATA STRUCTURE:
You are analyzing 18 KEY BUSINESS ACTIVITY INDICATORS covering profitability, turnover, productivity, operating cycle, and growth for TWO YEARS ({MainModel.BaseYear} and {MainModel.CurrentYear}).

INDICATOR CATEGORIES:
1. **Profitability Indicators (5):** Margins and returns
2. **Productivity Indicators (2):** Labor and asset productivity
3. **Turnover Indicators (8):** Asset velocity and efficiency
4. **Operating Cycle (1):** Cash-to-cash cycle
5. **Growth & Stability (2):** Sustainable growth capacity

NAMING CONVENTIONS:
Use proper readable names:
- ""Gross Profit Margin"" (UAH per UAH of sales)
- ""Business Activity Ratio"" (revenue to total assets)
- ""Labor Productivity"" (thousand UAH per employee)
- ""Fixed Asset Turnover"" (revenue per UAH of fixed assets)
- ""Receivables Turnover"" (times and days)
- ""Inventory Turnover"" (times and days)
- ""Operating Cycle Duration"" (days)
- ""Current Assets Turnover"" (times and days)
- ""Equity Turnover"" (times)
- ""Total Capital Turnover"" (times)
- ""Economic Growth Stability Ratio""
- ""Equity Payback Period"" (years)

Financial Data ({MainModel.BaseYear}-{MainModel.CurrentYear}):
{jsonData}

KEY FORMULAS:
- Gross Profit Margin = Gross Profit ÷ Revenue
- Business Activity Ratio = Revenue ÷ Average Total Assets
- Labor Productivity = Revenue ÷ Average Number of Employees
- Fixed Asset Turnover = Revenue ÷ Average Fixed Assets
- Receivables Turnover (Days) = 360 ÷ (Revenue ÷ Average Receivables)
- Inventory Turnover (Days) = 360 ÷ (COGS ÷ Average Inventory)
- Operating Cycle = Receivables Days + Inventory Days
- Current Assets Turnover = Revenue ÷ Average Current Assets
- Equity Turnover = Revenue ÷ Average Equity
- Total Capital Turnover = Revenue ÷ Average Total Capital
- Economic Growth Stability = Net Income ÷ Average Equity
- Equity Payback Period = 1 ÷ Economic Growth Stability

RESPONSE FORMAT:
- Professional narrative style
- Headings with ** (e.g., **1. Executive Summary**)
- Bullet points (•) for lists
- Numbers integrated into sentences
- NO tables or raw data dumps
- Focus on INTERPRETATION and OPERATIONAL IMPACT

ANALYSIS SECTIONS:

**1. Executive Summary - Business Activity Overview**:
   - 2-3 sentences on overall business activity performance
   - Primary finding: Activity increasing or decreasing?
   - Key strength and key weakness
   - Overall verdict on operational efficiency

**2. Profitability Indicators Analysis**:
   
   **Gross Profit Margin:**
   - {MainModel.BaseYear}: [value] UAH per UAH of sales
   - {MainModel.CurrentYear}: [value] UAH per UAH of sales
   - Interpretation: Pricing power and cost control
   
   **Business Activity Ratio:**
   - {MainModel.BaseYear}: [value] times
   - {MainModel.CurrentYear}: [value] times
   - Interpretation: How effectively assets generate revenue
   
   **Financial Resource Efficiency:**
   - Net income generation per UAH of assets
   - Trend analysis
   
   **Own Funds Utilization:**
   - Return on equity components
   - Equity productivity
   
   **Enterprise Profitability Ratio:**
   - Overall profitability assessment
   - Benchmark against industry

**3. Labor Productivity Analysis**:
   - {MainModel.BaseYear}: [value] thousand UAH per employee
   - {MainModel.CurrentYear}: [value] thousand UAH per employee
   - Change: [absolute] ([percentage]%)
   - **Interpretation:**
     • Improving = Workforce efficiency gains
     • Declining = Productivity issues
   - Root causes and implications

**4. Fixed Asset Turnover Analysis**:
   - {MainModel.BaseYear}: [value] UAH per UAH of fixed assets
   - {MainModel.CurrentYear}: [value] UAH per UAH of fixed assets
   - **Interpretation:**
     • >2.0 = Good asset utilization
     • 1.0-2.0 = Moderate
     • <1.0 = Underutilized assets
   - Capital efficiency assessment

**5. Receivables Turnover Analysis**:
   - Revolutions: {MainModel.BaseYear}: [X] times {MainModel.CurrentYear}: [Y] times
   - Days: {MainModel.BaseYear}: [X] days {MainModel.CurrentYear}: [Y] days
   - **Interpretation:**
     • Fewer days = Faster collection
     • More days = Slower collection
   - Credit policy effectiveness
   - Days Sales Outstanding (DSO) assessment

**6. Inventory Turnover Analysis**:
   - Revolutions: {MainModel.BaseYear}: [X] times {MainModel.CurrentYear}: [Y] times
   - Days: {MainModel.BaseYear}: [X] days {MainModel.CurrentYear}: [Y] days
   - **Interpretation:**
     • Higher turnover = Efficient inventory management
     • Lower turnover = Excess or slow-moving inventory
   - Inventory holding costs
   - Stock management efficiency

**7. Operating Cycle Duration - CRITICAL**:
   - {MainModel.BaseYear}: [value] days
   - {MainModel.CurrentYear}: [value] days
   - Change: [deviation] days
   - **Formula:** Receivables Days + Inventory Days
   - **Interpretation:**
     • Shorter cycle = Faster cash conversion
     • Longer cycle = More working capital tied up
   - Cash flow implications
   - Working capital requirements

**8. Current Assets Turnover Analysis**:
   - Revolutions: [times]
   - Days: [days]
   - Working capital velocity
   - Efficiency of current asset utilization

**9. Capital Turnover Analysis**:
   
   **Equity Turnover:**
   - {MainModel.BaseYear}: [value] times
   - {MainModel.CurrentYear}: [value] times
   - Shareholder capital productivity
   
   **Total Capital Turnover:**
   - {MainModel.BaseYear}: [value] times
   - {MainModel.CurrentYear}: [value] times
   - Overall capital efficiency
   - Comparison: Equity vs Total Capital turnover

**10. Economic Growth and Sustainability**:
    
    **Economic Growth Stability Ratio:**
    - Measures sustainable growth capacity
    - {MainModel.BaseYear}: [value]
    - {MainModel.CurrentYear}: [value]
    - **Interpretation:**
      • Positive & increasing = Sustainable growth
      • Negative = Unsustainable (consuming equity)
    
    **Equity Payback Period:**
    - {MainModel.BaseYear}: [value] years
    - {MainModel.CurrentYear}: [value] years
    - **Interpretation:**
      • Lower is better (faster recovery)
      • Shows how long to recover equity from earnings
      • If negative: Company is losing money
    
    **Strategic Implications:**
    - Growth sustainability
    - Investment attractiveness
    - Long-term viability

**11. Comprehensive Activity Assessment**:
    - Overall business activity level
    - Strengths: Which indicators performing well?
    - Weaknesses: Which indicators need improvement?
    - Comparative analysis:
      • Asset turnover trends
      • Working capital efficiency
      • Profitability vs activity balance

**12. Strategic Recommendations**:
    
    **For Improving Profitability:**
    • Gross margin enhancement strategies
    • Cost reduction opportunities
    • Pricing optimization
    • Target margins: [specific %]
    
    **For Improving Productivity:**
    • Labor productivity initiatives
    • Fixed asset utilization optimization
    • Technology and automation
    • Training and development
    • Target: [specific UAH/employee]
    
    **For Improving Turnover:**
    • **Receivables Management:**
      - Accelerate collections
      - Tighten credit terms
      - Target DSO: <[X] days
    
    • **Inventory Management:**
      - Optimize inventory levels
      - Reduce slow-moving stock
      - Just-in-time practices
      - Target turnover: >[X] times
    
    • **Operating Cycle Reduction:**
      - Current: [X] days
      - Target: <[Y] days
      - Methods: Faster collection + leaner inventory
    
    **For Capital Efficiency:**
    • Asset optimization
    • Working capital management
    • Capital allocation improvements
    • Target turnover ratios
    
    **For Sustainable Growth:**
    • Retain earnings for growth
    • Balanced expansion
    • Profitability focus
    • Target growth rate: [%]
    
    **Implementation Timeline:**
    • Immediate (30 days):
      - Collection acceleration
      - Inventory audit
      - Performance metrics review
    
    • Short-term (3-6 months):
      - Process improvements
      - Productivity enhancements
      - Working capital optimization
    
    • Long-term (1-2 years):
      - Strategic investments
      - Capability building
      - Sustainable growth achievement
    
    **Monthly KPIs to Track:**
    • Labor Productivity (UAH/employee)
    • Operating Cycle Duration (days)
    • Receivables Turnover (days)
    • Inventory Turnover (times)
    • Total Capital Turnover (times)
    • Gross Profit Margin (%)

INTERPRETATION GUIDANCE:
- **Turnover Ratios:** HIGHER is generally better (faster velocity)
- **Days Metrics:** LOWER is generally better (faster conversion)
- **Operating Cycle:** SHORTER is better (faster cash conversion)
- **Productivity:** HIGHER is better (more output per input)
- **Margins:** HIGHER is better (more profit per sale)

CRITICAL INSIGHTS:
1. What's the overall level of business activity?
2. Is the operating cycle improving or deteriorating?
3. Are receivables and inventory being managed effectively?
4. Is labor productivity improving?
5. Are assets (fixed, current, total) being utilized efficiently?
6. Is the business generating sustainable growth?
7. What's the balance between profitability and activity?
8. Which specific indicators need urgent attention?

SPECIAL CONSIDERATIONS:
- Operating cycle directly impacts cash flow
- Labor productivity reflects operational efficiency
- Asset turnover shows capital effectiveness
- Receivables/inventory days indicate working capital health
- Sustainable growth ratio shows long-term viability
- Negative profitability ratios indicate losses

WRITING STYLE:
- Direct and professional
- Active voice
- Integrate numbers naturally
- Explain WHY efficiency matters for operations
- Provide operational context
- Be analytical and actionable

All values in appropriate units (UAH, times, days, years). Write entire response in {languageInstruction}. DO NOT CREATE ANY TABLES.";
    }

    private void ClearAnalysis()
    {
        _aiAnalysis = string.Empty;
        _errorMessage = string.Empty;
    }

    private string FormatAIResponse(string response)
    {
        if (string.IsNullOrWhiteSpace(response))
            return string.Empty;

        return response
            .Replace("\n\n", "<br/><br/>")
            .Replace("\n", "<br/>")
            .Replace("**", "<strong>")
            .Replace("**", "</strong>")
            .Replace("- ", "• ");
    }
}