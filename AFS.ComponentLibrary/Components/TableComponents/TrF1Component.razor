<tr>
    <TdComponent TextAlignment="ML" Spacing=@Spacing>@FieldName</TdComponent>
    <TdComponent>@FieldNumber</TdComponent>
    <TdComponent TextAlignment="MR">
        <RadzenNumeric TValue="double" ShowUpDown="false" @bind-Value=@Field.Begin class="w-100" 
                       Placeholder="0.0" aria-label="@($"{FieldName} - {BeginLabel}")" />
    </TdComponent>
    <TdComponent TextAlignment="MR">
        <RadzenNumeric TValue="double" ShowUpDown="false" @bind-Value=@Field.End class="w-100"
                       Placeholder="0.0" aria-label="@($"{FieldName} - {EndLabel}")" />
    </TdComponent>
</tr>

@code {

    [Parameter]
    public BeginEnd Field { get; set; } = new();
    [Parameter]
    public string? FieldNumber { get; set; }
    [Parameter]
    public string? FieldName { get; set; }
    [Parameter]
    public string Spacing { get; set; } = String.Empty;

    private string BeginLabel => ResLoc["AtBeginningReportingPeriod"];
    private string EndLabel => ResLoc["AtEndingReportingPeriod"];
}
