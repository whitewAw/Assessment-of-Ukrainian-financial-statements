<TdComponent Align="MR">@AFSConstraints.RoundStr(Item.BeginningOfyear)</TdComponent>
<TdComponent Align="MR">@AFSConstraints.RoundStr(Item.EndOfYear)</TdComponent>
<TdComponent Align="MR">@AFSConstraints.RoundStr(Item.Deviations)</TdComponent>
<TdComponent Align="MR">@GetGrowthRateText()</TdComponent>

@code {
    [Parameter]
    public CharacteristicsOfCapitalCalculationRow Item { get; set; } = new();

    [Parameter]
    public bool IsShowGrowthRate { get; set; } = true;

    private string GetGrowthRateText() =>
        IsShowGrowthRate ? AFSConstraints.RoundStr(Item.GrowthRate) : "x";
}
