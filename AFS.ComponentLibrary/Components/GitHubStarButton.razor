@* GitHub Star Button Widget Component *@
@inject IJSRuntime JS

<div class="github-widget-container text-center my-4">
    <div id="github-star-button"></div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadGitHubButton();
        }
    }

    private async Task LoadGitHubButton()
    {
        try
        {
            await JS.InvokeVoidAsync("ufinInterop.mountGitHubStarButton", "github-star-button",
                "https://ghbtns.com/github-btn.html?user=whitewAw&repo=Assessment-of-Ukrainian-financial-statements&type=star&count=true&size=large");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"[GitHub Widget] Error loading button: {ex.Message}");
        }
    }
}

<style>
    .github-widget-container {
        padding: 20px;
        background: linear-gradient(135deg, #f6f8fa 0%, #ffffff 100%);
        border-radius: 8px;
        margin: 20px 0;
    }
</style>
