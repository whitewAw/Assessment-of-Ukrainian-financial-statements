@using AFS.Core.Interfaces
@inject IAIFinancialAdvisor AIAdvisor
@inject IJSRuntime JS

<div class="ai-chat-container">
    <div class="ai-status-bar">
        @if (_isCheckingAvailability)
        {
            <span class="status-checking">
                <span class="spinner-border spinner-border-sm me-2"></span>
                Checking AI availability...
            </span>
        }
        else if (_isAvailable)
        {
            <span class="status-available">
                <i class="oi oi-check me-2"></i>
                @_statusMessage
            </span>
        }
        else
        {
            <span class="status-unavailable">
                <i class="oi oi-warning me-2"></i>
                @_statusMessage
            </span>
        }
    </div>

    <div class="chat-messages" @ref="_messagesContainer">
        @foreach (var message in _messages)
        {
            <div class="message @(message.IsUser ? "user-message" : "ai-message")">
                <div class="message-header">
                    <strong>@(message.IsUser ? "You" : "AI Assistant")</strong>
                    <span class="message-time">@message.Timestamp.ToString("HH:mm")</span>
                </div>
                <div class="message-content">
                    @((MarkupString)FormatMessage(message.Content))
                </div>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="message ai-message">
                <div class="message-header">
                    <strong>AI Assistant</strong>
                </div>
                <div class="message-content">
                    <span class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                    @if (!string.IsNullOrEmpty(_streamingResponse))
                    {
                        <div class="streaming-text">@((MarkupString)FormatMessage(_streamingResponse))</div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="chat-input-area">
        <div class="quick-actions mb-2">
            <button class="btn btn-sm btn-outline-primary me-2"
                    @onclick="() => SendQuickPrompt(QuickPrompts.FinancialHealth)"
                    disabled="@(!_isAvailable || _isProcessing)">
                <i class="oi oi-pulse me-1"></i> Financial Health
            </button>
            <button class="btn btn-sm btn-outline-primary me-2"
                    @onclick="() => SendQuickPrompt(QuickPrompts.Recommendations)"
                    disabled="@(!_isAvailable || _isProcessing)">
                <i class="oi oi-lightbulb me-1"></i> Get Recommendations
            </button>
            <button class="btn btn-sm btn-outline-primary"
                    @onclick="() => SendQuickPrompt(QuickPrompts.KeyRatios)"
                    disabled="@(!_isAvailable || _isProcessing)">
                <i class="oi oi-graph me-1"></i> Explain Key Ratios
            </button>
        </div>

        <div class="input-group">
            <input type="text"
                   class="form-control"
                   placeholder="Ask about your financial data..."
                   @bind="_userInput"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   disabled="@(!_isAvailable || _isProcessing)" />
            <button class="btn btn-primary"
                    @onclick="SendMessage"
                    disabled="@(!_isAvailable || _isProcessing || string.IsNullOrWhiteSpace(_userInput))">
                <i class="oi oi-@(_isProcessing ? "reload" : "paper-plane")"></i>
            </button>
        </div>
    </div>
</div>

@code {
    private ElementReference _messagesContainer;
    private List<ChatMessage> _messages = new();
    private string _userInput = string.Empty;
    private string _streamingResponse = string.Empty;
    private bool _isProcessing = false;
    private bool _isCheckingAvailability = true;
    private bool _isAvailable = false;
    private string _statusMessage = string.Empty;

    private enum QuickPrompts
    {
        FinancialHealth,
        Recommendations,
        KeyRatios
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckAIAvailability();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _messages.Count > 0)
        {
            await ScrollToBottom();
        }
    }

    private async Task CheckAIAvailability()
    {
        _isCheckingAvailability = true;
        StateHasChanged();

        var (isAvailable, message) = await AIAdvisor.CheckAvailabilityAsync();
        _isAvailable = isAvailable;
        _statusMessage = message;
        _isCheckingAvailability = false;

        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || !_isAvailable || _isProcessing)
            return;

        var userMessage = _userInput.Trim();
        _userInput = string.Empty;

        // Add user message
        _messages.Add(new ChatMessage
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.Now
        });

        _isProcessing = true;
        _streamingResponse = string.Empty;
        StateHasChanged();

        try
        {
            // Use streaming for better UX
            var response = await AIAdvisor.GetStreamingResponseAsync(userMessage, chunk =>
                    {
                        _streamingResponse += chunk;
                        InvokeAsync(StateHasChanged);
                    });

            // Add AI response
            _messages.Add(new ChatMessage
            {
                Content = response,
                IsUser = false,
                Timestamp = DateTime.Now
            });

            _streamingResponse = string.Empty;
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage
            {
                Content = $"? Error: {ex.Message}",
                IsUser = false,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SendQuickPrompt(QuickPrompts promptType)
    {
        _userInput = promptType switch
        {
            QuickPrompts.FinancialHealth => "Analyze the overall financial health of my company based on the available data.",
            QuickPrompts.Recommendations => "What are your top recommendations to improve my company's financial position?",
            QuickPrompts.KeyRatios => "Explain the most important financial ratios I should focus on.",
            _ => string.Empty
        };

        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
       "document.querySelector('.chat-messages').scrollTop = document.querySelector('.chat-messages').scrollHeight");
        }
        catch { /* Ignore scroll errors */ }
    }

    private string FormatMessage(string content)
    {
        // Simple markdown-like formatting
        var formatted = content
         .Replace("\n", "<br/>")
        .Replace("**", "<strong>")
            .Replace("**", "</strong>");

        return formatted;
    }

    private class ChatMessage
    {
        public string Content { get; set; } = string.Empty;
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
    }
}

<style>
    .ai-chat-container {
        display: flex;
        flex-direction: column;
        height: 600px;
        max-height: 80vh;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background-color: #f8f9fa;
    }

    .ai-status-bar {
        padding: 10px 15px;
        background-color: #fff;
        border-bottom: 1px solid #dee2e6;
        font-size: 0.9rem;
    }

    .status-checking {
        color: #6c757d;
    }

    .status-available {
        color: #28a745;
    }

    .status-unavailable {
        color: #dc3545;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .message {
        max-width: 80%;
        padding: 12px 16px;
        border-radius: 12px;
        animation: fadeIn 0.3s ease-in;
    }

    .user-message {
        align-self: flex-end;
        background-color: #007bff;
        color: white;
    }

    .ai-message {
        align-self: flex-start;
        background-color: white;
        border: 1px solid #dee2e6;
    }

    .message-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 0.85rem;
        opacity: 0.8;
    }

    .message-content {
        line-height: 1.5;
    }

    .typing-indicator {
        display: inline-flex;
        gap: 4px;
    }

        .typing-indicator span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #6c757d;
            animation: bounce 1.4s infinite ease-in-out;
        }

            .typing-indicator span:nth-child(1) {
                animation-delay: -0.32s;
            }

            .typing-indicator span:nth-child(2) {
                animation-delay: -0.16s;
            }

    .streaming-text {
        margin-top: 10px;
    }

    .chat-input-area {
        padding: 15px;
        background-color: white;
        border-top: 1px solid #dee2e6;
    }

    .quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes bounce {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }
</style>
