        .send-btn .oi {
            color: #fff !important;
            font-size: 1.2rem !important;
        }

        .send-btn:hover:not(:disabled) {
            background-color: #0056b3 !important;
            border-color: #0056b3 !important;
        }

        .send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .stop-btn {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
