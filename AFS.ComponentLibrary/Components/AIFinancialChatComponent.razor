    .quick-action-btn {
        color: #007bff !important;
        border-color: #007bff !important;
        background-color: transparent !important;
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
        white-space: nowrap;
    }

        .quick-action-btn .oi {
            color: #007bff !important;
