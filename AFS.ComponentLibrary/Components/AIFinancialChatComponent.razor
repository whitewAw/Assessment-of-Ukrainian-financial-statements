@using AFS.Core.Interfaces
@using AFS.Core.Models
@using AFS.Core.Services
@using AFS.ComponentLibrary.Resources
@using Microsoft.Extensions.Localization
@inject IAIFinancialAdvisor AIAdvisor
@inject IJSRuntime JS
@inject AfsModel AfsModel
@inject IStringLocalizer<Resource> ResLoc

<div class="ai-chat-container">
    <div class="ai-status-bar">
        @if (_isCheckingAvailability)
        {
            <span class="status-checking">
                <span class="spinner-border spinner-border-sm me-2"></span>
                @ResLoc["CheckingAIAvailability"]
            </span>
        }
        else if (_isDownloading)
        {
            <div class="status-downloading">
                <div class="d-flex align-items-center">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>@string.Format(ResLoc["DownloadingGeminiNano"], _downloadProgress)</span>
                </div>
                <div class="progress mt-2" style="height: 20px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: @(_downloadProgress)%"
                         aria-valuenow="@_downloadProgress"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @_downloadProgress%
                    </div>
                </div>
            </div>
        }
        else if (_isAvailable)
        {
            <span class="status-available">
                <RadzenIcon Icon="check_circle" class="me-2" />
                @_statusMessage
            </span>
        }
        else
        {
            <div class="alert alert-danger mb-0" role="alert" style="background-color: #f8d7da; border-color: #f5c2c7; color: #842029;">
                <h6 class="alert-heading" style="color: #842029;">
                    <RadzenIcon Icon="warning" class="me-2" />
                    @ResLoc["AINotAvailable"]
                </h6>
                <div style="white-space: pre-line; font-size: 0.9rem; color: #842029;">@_statusMessage</div>
            </div>
        }
    </div>

    <div class="chat-messages">
        @if (!_isAvailable && !_isCheckingAvailability)
        {
            <div class="text-center text-muted p-4">
                <RadzenIcon Icon="info" style="font-size: 3rem; color: #6c757d;" />
                <h5 class="mt-3" style="color: #495057;">@ResLoc["AINotReady"]</h5>
                <p style="color: #6c757d;">@ResLoc["AIFollowSetupInstructions"]</p>
                <button class="btn btn-primary mt-2" @onclick="CheckAIAvailability">
                    <RadzenIcon Icon="refresh" class="me-2" />
                    @ResLoc["RecheckAvailability"]
                </button>
            </div>
        }
        else if (_isAvailable)
        {
            @foreach (var message in _messages)
            {
                <div class="message @(message.IsUser ? "user-message" : "ai-message")">
                    <div class="message-header">
                        <strong>@(message.IsUser? ResLoc["You"] : ResLoc["AIAssistantName"])</strong>
                        <span class="message-time">@message.Timestamp.ToString("HH:mm")</span>
                    </div>
                    <div class="message-content">
                        @((MarkupString)FormatMessage(message.Content))
                    </div>
                </div>
            }

            @if (_isProcessing)
            {
                <div class="message ai-message">
                    <div class="message-header">
                        <strong>@ResLoc["AIAssistantName"]</strong>
                    </div>
                    <div class="message-content">
                        <span class="typing-indicator">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        @if (!string.IsNullOrEmpty(_streamingResponse))
                        {
                            <div class="streaming-text">@((MarkupString)FormatMessage(_streamingResponse))</div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="chat-input-area">
        <div class="quick-actions mb-2">
            <button class="btn btn-sm btn-outline-primary me-2 quick-action-btn"
                    @onclick="() => SendQuickPrompt(QuickPrompts.FinancialHealth)"
                    disabled="@(!_isAvailable || _isProcessing)">
                <RadzenIcon Icon="favorite" class="me-1" /> @ResLoc["FinancialHealthButton"]
            </button>
            <button class="btn btn-sm btn-outline-primary me-2 quick-action-btn"
                    @onclick="() => SendQuickPrompt(QuickPrompts.Recommendations)"
                    disabled="@(!_isAvailable || _isProcessing)">
                <RadzenIcon Icon="lightbulb" class="me-1" /> @ResLoc["GetRecommendationsButton"]
            </button>
            <button class="btn btn-sm btn-outline-primary quick-action-btn"
                    @onclick="() => SendQuickPrompt(QuickPrompts.KeyRatios)"
                    disabled="@(!_isAvailable || _isProcessing)">
                <RadzenIcon Icon="show_chart" class="me-1" /> @ResLoc["ExplainKeyRatiosButton"]
            </button>
        </div>

        <div class="input-group">
            <input type="text"
                   class="form-control chat-input"
                   placeholder="@(_isAvailable? ResLoc["AskAboutFinancialData"] : ResLoc["EnableChromeAIToChat"])"
                   @bind="_userInput"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   disabled="@(!_isAvailable || _isProcessing)" />
            @if (_isProcessing)
            {
                <button class="btn btn-danger stop-btn"
                        @onclick="StopStreaming"
                        title="@ResLoc["StopGeneration"]">
                    <RadzenIcon Icon="stop" />
                </button>
            }
            else
            {
                <button class="btn btn-primary send-btn"
                        @onclick="SendMessage"
                        disabled="@(!_isAvailable || _isProcessing || string.IsNullOrWhiteSpace(_userInput))"
                        title="@(!_isAvailable ? ResLoc["AINotAvailable"] : ResLoc["SendMessage"])">
                    <RadzenIcon Icon="send" />
                </button>
            }
        </div>
    </div>
</div>

@code {
private readonly List<ChatMessage> _messages = new();
private string _userInput = string.Empty;
private string _streamingResponse = string.Empty;
private bool _isProcessing = false;
private bool _isCheckingAvailability = true;
private bool _isAvailable = false;
private bool _isDownloading = false;
private int _downloadProgress = 0;
private string _statusMessage = string.Empty;

private enum QuickPrompts
    {
        FinancialHealth,
        Recommendations,
        KeyRatios
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckAIAvailability();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _messages.Count > 0)
        {
            await ScrollToBottom();
        }
    }

    private async Task CheckAIAvailability()
    {
        _isCheckingAvailability = true;
        StateHasChanged();

        try
        {
            var (isAvailable, message) = await AIAdvisor.CheckAvailabilityAsync();

            // If model is downloadable, try to create session with progress
            if (!isAvailable && message.Contains("downloaded"))
            {
                _isDownloading = true;
                _isCheckingAvailability = false;
                StateHasChanged();

                if (AIAdvisor is AFS.Core.Services.BrowserAIFinancialAdvisor browserAdvisor)
                {
                    var sessionCreated = await browserAdvisor.CreateSessionWithProgressAsync(progress =>
                    {
                        _downloadProgress = progress;
                        InvokeAsync(StateHasChanged);
                    });

                    if (sessionCreated)
                    {
                        _isAvailable = true;
                        _statusMessage = ResLoc["AIReady"];
                    }
                    else
                    {
                        _isAvailable = false;
                        _statusMessage = message;
                    }
                }

                _isDownloading = false;
            }
            else
            {
                _isAvailable = isAvailable;
                _statusMessage = message;
            }
        }
        catch (Exception ex)
        {
            _isAvailable = false;
            _statusMessage = $"Error checking AI availability: {ex.Message}";
        }
        finally
        {
            _isCheckingAvailability = false;
            _isDownloading = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || !_isAvailable || _isProcessing)
            return;

        var userMessage = _userInput.Trim();
        _userInput = string.Empty;

        // Add user message
        _messages.Add(new ChatMessage
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.Now
        });

        _isProcessing = true;
        _streamingResponse = string.Empty;
        StateHasChanged();

        try
        {
            // Get current culture and language
            string languageInstruction = AfsConstraints.GetLanguageInstruction();

            // Build comprehensive financial context
            var financialContext = BuildFinancialContext();

            // Build conversation history (last 5 messages for context)
            var conversationHistory = BuildConversationHistory();

            // Build simplified, conversational prompt with history
            var contextualPrompt = $@"You are a financial analyst assistant. Answer the user's question directly and concisely using the company's actual financial data.

IMPORTANT: Respond in {languageInstruction} language.

COMPANY DATA ({AfsModel.CompanyName}, {AfsModel.BaseYear}-{AfsModel.CurrentYear}):
{financialContext}

{conversationHistory}

CURRENT USER QUESTION:
{userMessage}

ANSWER GUIDELINES:
- Answer directly without headers or formal structure
- Use actual numbers from the data
- Be conversational and clear
- Keep it brief but informative
- Use • for bullet points if needed
- Show calculations when relevant
- Reference previous conversation if relevant

Answer in {languageInstruction}:";

            // Use streaming for better UX
            await AIAdvisor.GetStreamingResponseAsync(contextualPrompt, chunk =>
            {
                _streamingResponse += chunk;
                InvokeAsync(StateHasChanged);
            });

            // Add AI response
            if (!string.IsNullOrEmpty(_streamingResponse))
            {
                _messages.Add(new ChatMessage
                {
                    Content = _streamingResponse.TrimEnd('\n', '\r'),
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            }

            _streamingResponse = string.Empty;
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage
            {
                Content = $"? Error: {ex.Message}",
                IsUser = false,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Build conversation history for context-aware responses
    /// </summary>
    private string BuildConversationHistory()
    {
        // Only include last 5 messages (10 total with responses) to keep context manageable
        // Exclude the message we just added
        var recentMessages = _messages
            .Take(_messages.Count - 1) // Exclude the current message
            .TakeLast(10)               // Last 10 messages (5 exchanges)
            .ToList();

        if (recentMessages.Count == 0)
        {
            return string.Empty;
        }

        var historyBuilder = new System.Text.StringBuilder();
        historyBuilder.AppendLine("CONVERSATION HISTORY:");
        
        foreach (var msg in recentMessages)
        {
            var speaker = msg.IsUser ? "User" : "Assistant";
            historyBuilder.AppendLine($"{speaker}: {msg.Content}");
            historyBuilder.AppendLine();
        }

        return historyBuilder.ToString();
    }

    private async Task StopStreaming()
    {
        try
        {
            // Call JavaScript to abort the current operation
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chromeai.js");
            await module.InvokeVoidAsync("abortCurrentOperation");

            // Add system message
            if (!string.IsNullOrEmpty(_streamingResponse))
            {
                _messages.Add(new ChatMessage
                {
                    Content = _streamingResponse.TrimEnd('\n', '\r') + "\n\n[Response stopped by user]",
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            }

            _streamingResponse = string.Empty;
            _isProcessing = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping stream: {ex.Message}");
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SendQuickPrompt(QuickPrompts promptType)
    {
        string userMessage = promptType switch
        {
            QuickPrompts.FinancialHealth => "Analyze the overall financial health of my company based on the available data.",
            QuickPrompts.Recommendations => "What are your top recommendations to improve my company's financial position?",
            QuickPrompts.KeyRatios => "Explain the most important financial ratios I should focus on.",
            _ => string.Empty
        };

        if (string.IsNullOrEmpty(userMessage))
            return;

        // Add user message
        _messages.Add(new ChatMessage
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.Now
        });

        _isProcessing = true;
        _streamingResponse = string.Empty;
        StateHasChanged();

        try
        {
            // Build comprehensive context-aware prompt
            var contextualPrompt = BuildQuickPromptWithContext(promptType);

            // Use streaming for better UX
            await AIAdvisor.GetStreamingResponseAsync(contextualPrompt, chunk =>
            {
                _streamingResponse += chunk;
                InvokeAsync(StateHasChanged);
            });

            // Add AI response
            if (!string.IsNullOrEmpty(_streamingResponse))
            {
                _messages.Add(new ChatMessage
                {
                    Content = _streamingResponse.TrimEnd('\n', '\r'),
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            }

            _streamingResponse = string.Empty;
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage
            {
                Content = $"? Error: {ex.Message}",
                IsUser = false,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private string BuildQuickPromptWithContext(QuickPrompts promptType)
    {
        string languageInstruction = AfsConstraints.GetLanguageInstruction();

        var financialContext = BuildFinancialContext();

        return promptType switch
        {
            QuickPrompts.FinancialHealth => BuildFinancialHealthPrompt(financialContext, languageInstruction),
            QuickPrompts.Recommendations => BuildRecommendationsPrompt(financialContext, languageInstruction),
            QuickPrompts.KeyRatios => BuildKeyRatiosPrompt(financialContext, languageInstruction),
            _ => BuildGeneralFinancialAnalysisPrompt(financialContext, languageInstruction)
        };
    }

    private string BuildFinancialContext()
    {
        // Use AOT-optimized JSON serialization
        return JsonSerializationHelper.SerializeFinancialContext(AfsModel);
    }

    private string BuildFinancialHealthPrompt(string context, string language)
    {
        return $@"You are a professional financial analyst. Analyze the overall financial health of {AfsModel.CompanyName} based on the provided data.

IMPORTANT: Respond in {language} language.

FINANCIAL DATA ({AfsModel.BaseYear}-{AfsModel.CurrentYear}):
{context}

PROVIDE COMPREHENSIVE ANALYSIS:

**1. Executive Summary**
- Overall financial health verdict (Excellent/Good/Fair/Poor/Critical)
- 2-3 key findings
- Primary concerns

**2. Profitability Analysis**
- Revenue trends
- Profit margins
- Year-over-year changes
- Assessment

**3. Liquidity Analysis**
- Working capital position
- Current ratio estimate
- Cash flow implications
- Assessment

**4. Solvency Analysis**
- Debt levels
- Equity position
- Leverage assessment
- Risk level

**5. Asset Efficiency**
- Asset base changes
- Asset structure
- Efficiency indicators

**6. Top 3 Strengths**
- List strongest aspects

**7. Top 3 Weaknesses**
- List areas of concern

**8. Risk Assessment**
- Financial risks (High/Medium/Low)
- Key risk factors

**9. Overall Verdict**
- Final assessment
- Outlook

Respond in {language}. Use ** for headings and • for bullets.";
    }

    private string BuildRecommendationsPrompt(string context, string language)
    {
        return $@"You are a professional financial consultant. Provide TOP RECOMMENDATIONS to improve {AfsModel.CompanyName}'s financial position.

IMPORTANT: Respond in {language} language.

FINANCIAL DATA ({AfsModel.BaseYear}-{AfsModel.CurrentYear}):
{context}

PROVIDE ACTIONABLE RECOMMENDATIONS:

**Priority 1: URGENT (0-3 months)**
List 2-3 most critical actions needed immediately

**Priority 2: HIGH (3-6 months)**
List 2-3 important improvements

**Priority 3: MEDIUM (6-12 months)**
List 2-3 strategic initiatives

**Priority 4: LONG-TERM (1-2 years)**
List 2-3 transformational changes

For EACH recommendation provide:
• Specific action
• Expected impact
• Timeline
• Success metrics

**Quick Wins**
List 2-3 easy improvements with high impact

**Risk Mitigation**
List 2-3 risk reduction actions

Respond in {language}. Be specific and actionable. Use ** for headings and • for bullets.";
    }

    private string BuildKeyRatiosPrompt(string context, string language)
    {
        return $@"You are a professional financial analyst. Explain the MOST IMPORTANT financial ratios for {AfsModel.CompanyName}.

IMPORTANT: Respond in {language} language.

FINANCIAL DATA ({AfsModel.BaseYear}-{AfsModel.CurrentYear}):
{context}

CALCULATE AND EXPLAIN KEY RATIOS:

**1. Profitability Ratios**
Calculate from the data:
• Gross Profit Margin
• Operating Profit Margin
• Net Profit Margin
• Return on Assets (ROA)
• Return on Equity (ROE)

For each: Formula, calculation, result, interpretation, benchmark

**2. Liquidity Ratios**
Calculate from the data:
• Current Ratio
• Quick Ratio (if possible)
• Working Capital

For each: Formula, calculation, result, interpretation, benchmark

**3. Leverage Ratios**
Calculate from the data:
• Debt-to-Equity Ratio
• Debt-to-Assets Ratio
• Equity Ratio

For each: Formula, calculation, result, interpretation, benchmark

**4. What These Ratios Mean**
- Overall financial position
- Strengths indicated
- Weaknesses indicated
- Trends ({AfsModel.BaseYear} vs {AfsModel.CurrentYear})

**5. Which Ratios to Watch**
- Top 3 most important for this company
- Why they matter
- Target values

Respond in {language}. Show calculations. Use ** for headings and • for bullets.";
    }

    private string BuildGeneralFinancialAnalysisPrompt(string context, string language)
    {
        return $@"You are a professional financial analyst specializing in Ukrainian financial reporting standards.

IMPORTANT: Respond in {language} language.

COMPANY FINANCIAL DATA ({AfsModel.CompanyName}):
{context}

DATA PERIOD: {AfsModel.BaseYear} - {AfsModel.CurrentYear}

ANALYSIS FRAMEWORK:

**Your Role:**
Provide comprehensive financial analysis based on the actual data provided. Focus on data-driven insights, specific calculations, and actionable recommendations.

**Analysis Guidelines:**

**1. Use Actual Numbers**
- Always reference specific values from the data
- Calculate ratios from the provided figures
- Show year-over-year changes with percentages

**2. Provide Context**
- Compare {AfsModel.BaseYear} vs {AfsModel.CurrentYear}
- Identify trends (improving/deteriorating)
- Benchmark against industry standards where applicable

**3. Be Specific**
- Instead of ""high debt,"" say ""Debt of X represents Y% of total assets""
- Instead of ""good liquidity,"" calculate ""Current ratio of 1.5 indicates...""
- Quantify impacts: ""Reducing debt by X would improve ratio by Y""

**4. Structure Your Response**
Use clear sections with **headings** and bullet points (•):
- Start with key findings
- Provide detailed analysis
- End with specific recommendations

**5. Calculate Key Metrics**
When relevant, calculate and explain:
• Profitability: Gross margin, net margin, ROA, ROE
• Liquidity: Current ratio, working capital
• Leverage: Debt-to-equity, debt-to-assets
• Efficiency: Asset turnover, trends

**6. Risk Assessment**
- Identify specific risks from the data
- Quantify risk levels (High/Medium/Low)
- Suggest mitigation strategies

**7. Recommendations**
Provide actionable steps:
• What to do
• Expected impact (quantified)
• Timeline
• Success metrics

**Format:**
- Use ** for section headings
- Use • for bullet points
- Include specific numbers and percentages
- Show calculations when relevant
- Be concise but comprehensive

Respond in {language}. Base everything on the actual financial data provided.";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.querySelector('.chat-messages').scrollTop = document.querySelector('.chat-messages').scrollHeight");
        }
        catch { /* Ignore scroll errors */ }
    }

    private static string FormatMessage(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        // Simple markdown-like formatting
        var formatted = content
            .Replace("**", "<strong>")
            .Replace("**", "</strong>")
            .Replace("\n", "<br/>");

        return formatted;
    }

    private sealed class ChatMessage
    {
        public string Content { get; set; } = string.Empty;
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
    }
}

<style>
