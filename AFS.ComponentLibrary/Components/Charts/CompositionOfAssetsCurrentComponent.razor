@page "/compositionofassetscurrent"
@using AFS.Core.Models
@using AFS.Core.Interfaces
@using AFS.Core.Services
@inject CompositionOfAssetsChart CompositionOfAssetsChart
@inject AfsModel AfsModel
@inject IAIFinancialAdvisor AIAdvisor
@inject IJSRuntime JS

<RadzenCard Style="width: 100%;">
    <h2 class="text-center">@tableName</h2>
    <CompositionOfAssetsDonutChartComponent Period=@ResLoc["atBeginOfYear"] ChartAssets=@baseList />
    <CompositionOfAssetsDonutChartComponent Period=@ResLoc["atEndOfYear"] ChartAssets=@currentList />
</RadzenCard>

@* @ResLoc["AIFinancialAnalysis"] Section *@
<RadzenCard Style="width: 100%; margin-top: 20px;">
    <h3 class="text-center mb-4">
        <i class="oi oi-brain me-2"></i>
        @ResLoc["AIFinancialAnalysis"]
    </h3>

    @if (_isCheckingAvailability)
    {
        <div class="d-flex justify-content-center mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span class="text-muted">@ResLoc["CheckingAIAvailability"]</span>
        </div>
    }
    else if (!_isAIAvailable)
    {
        <div class="alert alert-warning">
            <h6 class="alert-heading">
                <i class="oi oi-warning me-2"></i>
                @ResLoc["ChromeAINotAvailable"]
            </h6>
            <p class="mb-2">
                @ResLoc["ChromeAINotAvailableMessage"]
                <a href="/Assessment-of-Ukrainian-financial-statements/ai-assistant" class="alert-link">@ResLoc["AIAssistantPage"]</a>
                @ResLoc["ForSetupInstructions"]
            </p>
            <button class="btn btn-sm btn-primary" @onclick="CheckAIAvailability">
                <i class="oi oi-reload me-2"></i>
                @ResLoc["RecheckAvailability"]
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3">
            @if (_isAnalyzing)
            {
                <button class="btn btn-danger me-2" @onclick="StopAnalysis">
                    <i class="oi oi-media-stop me-2"></i>
                    <span>@ResLoc["StopAnalysis"]</span>
                </button>
            }
            else
            {
                <button class="btn btn-primary me-2" @onclick="AnalyzeAssetComposition" disabled="@(!_isAIAvailable)">
                    <i class="oi oi-magnifying-glass me-2"></i>
                    <span>@string.Format(ResLoc["AnalyzeAssetComposition"], MainModel.CurrentYear)</span>
                </button>
            }

            @if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAnalysis">
                    <i class="oi oi-x me-2"></i>
                    @ResLoc["Clear"]
                </button>
            }
        </div>

        @if (_isAnalyzing || !string.IsNullOrEmpty(_aiAnalysis))
        {
            <div class="alert alert-info">
                @if (_isAnalyzing && string.IsNullOrEmpty(_aiAnalysis))
                {
                    <div class="d-flex align-items-center">
                        <span class="typing-indicator me-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span class="text-muted">AI is analyzing asset composition...</span>
                    </div>
                }
                <div style="white-space: pre-wrap; line-height: 1.6;">
                    @((MarkupString)FormatAIResponse(_aiAnalysis))
                </div>
            </div>
        }
    }


    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>@ResLoc["Error"]:</strong> @_errorMessage
        </div>
    }
</RadzenCard>

@code {
private string? tableName;
List<ChartDataItem>? baseList;
List<ChartDataItem>? currentList;

private string _aiAnalysis = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isAnalyzing = false;
    private bool _isCheckingAvailability = true;
    private bool _isAIAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        string name = ResLoc["CompositionOfAssets"];
        string number = "II.";

        tableName = $"{number} {name} - {MainModel.CurrentYear} {@ResLoc["year"]}";

        baseList = CompositionOfAssetsChart.GetDataItem(false, true);
        currentList = CompositionOfAssetsChart.GetDataItem(false, false);

        await CheckAIAvailability();

        base.OnInitialized();
    }

    private async Task CheckAIAvailability()
    {
        _isCheckingAvailability = true;
        StateHasChanged();

        try
        {
            var (isAvailable, _) = await AIAdvisor.CheckAvailabilityAsync();
            _isAIAvailable = isAvailable;
        }
        catch (Exception)
        {
            _isAIAvailable = false;
        }
        finally
        {
            _isCheckingAvailability = false;
            StateHasChanged();
        }
    }

    private async Task AnalyzeAssetComposition()
    {
        if (!_isAIAvailable)
        {
            _errorMessage = "Chrome AI is not available. Please check the setup instructions.";
            return;
        }

        _isAnalyzing = true;
        _errorMessage = string.Empty;
        _aiAnalysis = string.Empty;
        StateHasChanged();

        try
        {
            var prompt = BuildAssetCompositionPrompt();

            await AIAdvisor.GetStreamingResponseAsync(prompt, chunk =>
            {
                _aiAnalysis += chunk;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("cancelled") || ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrEmpty(_aiAnalysis))
                {
                    _aiAnalysis += "\n\n[Analysis stopped by user]";
                }
                else
                {
                    _errorMessage = "Analysis was stopped by user.";
                }
            }
            else
            {
                _errorMessage = $"Failed to analyze data: {ex.Message}";
            }
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task StopAnalysis()
    {
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chromeai.js");
            await module.InvokeVoidAsync("abortCurrentOperation");

            // Note: The stopped message is added by the catch block in the analyze method

            _isAnalyzing = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping analysis: {ex.Message}");
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private string BuildAssetCompositionPrompt()
    {
        string languageInstruction = AfsConstraints.GetLanguageInstruction();

        // Use AOT-optimized JSON serialization
        var jsonData = JsonSerializationHelper.SerializeAssetComposition(
            MainModel.CompanyName,
            MainModel.CurrentYear,
            baseList,
            currentList
        );

        return $@"You are a financial analyst specializing in asset structure analysis and portfolio optimization. Analyze the Composition of Assets for {MainModel.CompanyName} for {MainModel.CurrentYear} (comparing to previous year {MainModel.BaseYear}).

IMPORTANT: Respond in {languageInstruction} language.

CRITICAL FORMATTING RULES:
- DO NOT create or display any tables
- Focus on INTERPRETATION, INSIGHTS, and RECOMMENDATIONS
- Use narrative prose with clear sections and bullet points

Asset Composition Data:
{jsonData}

Focus on:
1. Year-over-year changes in asset structure from {MainModel.BaseYear} to {MainModel.CurrentYear}
2. Strategic shifts and trends
3. Evolution of asset allocation
4. Future implications of structural changes

Provide 8-section analysis emphasizing changes and strategic evolution.

Write entire response in {languageInstruction}. DO NOT CREATE ANY TABLES.";
    }

    private void ClearAnalysis()
    {
        _aiAnalysis = string.Empty;
        _errorMessage = string.Empty;
    }

    private static string FormatAIResponse(string response)
    {
        if (string.IsNullOrWhiteSpace(response))
            return string.Empty;

        return response
            .Replace("\n\n", "<br/><br/>")
            .Replace("\n", "<br/>")
            .Replace("**", "<strong>")
            .Replace("**", "</strong>")
            .Replace("- ", "• ");
    }
}
