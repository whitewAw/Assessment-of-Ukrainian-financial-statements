@page "/workingcapitalturnovertime"
@using AFS.Core.Models
@using AFS.Core.Interfaces
@using AFS.Core.Services
@using AFS.ComponentLibrary.Helpers
@inject WorkingCapitalTurnoverTimeChart WorkingCapitalTurnoverTimeChart
@inject AFSModel AFSModel
@inject IAIFinancialAdvisor AIAdvisor
@inject IJSRuntime JS

<RadzenCard Style="width: 100%;">
    <h2 class="text-center">@tableName</h2>
    <ApexChart TItem="ChartDateTimeItem"
               Height="350"
               Options="@_lineChartOptions">
        <ApexPointSeries TItem="ChartDateTimeItem"
                         Items="money"
                         Name="@ResLoc["MoneyAndTheirEquivalents"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("MM/yyyy"))"
                         YValue="@(e => (decimal?)e.Value)" />
        <ApexPointSeries TItem="ChartDateTimeItem"
                         Items="receivables"
                         Name="@ResLoc["AccountsReceivable"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("MM/yyyy"))"
                         YValue="@(e => (decimal?)e.Value)" />
        <ApexPointSeries TItem="ChartDateTimeItem"
                         Items="materialValues"
                         Name="@ResLoc["Tangibles"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("MM/yyyy"))"
                         YValue="@(e => (decimal?)e.Value)" />
    </ApexChart>
</RadzenCard>

@* @ResLoc["AIFinancialAnalysis"] Section *@
<RadzenCard Style="width: 100%; margin-top: 20px;">
    <h3 class="text-center mb-4">
        <i class="oi oi-brain me-2"></i>
        @ResLoc["AIFinancialAnalysis"]
    </h3>
    
    @if (_isCheckingAvailability)
    {
        <div class="d-flex justify-content-center mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span class="text-muted">@ResLoc["CheckingAIAvailability"]</span>
        </div>
    }
    else if (!_isAIAvailable)
    {
        <div class="alert alert-warning">
            <h6 class="alert-heading">
                <i class="oi oi-warning me-2"></i>
                @ResLoc["ChromeAINotAvailable"]
            </h6>
            <p class="mb-2">
                @ResLoc["ChromeAINotAvailableMessage"]
                <a href="/Assessment-of-Ukrainian-financial-statements/ai-assistant" class="alert-link">@ResLoc["AIAssistantPage"]</a>
                @ResLoc["ForSetupInstructions"]
            </p>
            <button class="btn btn-sm btn-primary" @onclick="CheckAIAvailability">
                <i class="oi oi-reload me-2"></i>
                @ResLoc["RecheckAvailability"]
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3">
            @if (_isAnalyzing)
            {
                <button class="btn btn-danger me-2" @onclick="StopAnalysis">
                    <i class="oi oi-media-stop me-2"></i>
                    <span>@ResLoc["StopAnalysis"]</span>
                </button>
            }
            else
            {
                <button class="btn btn-primary me-2" @onclick="AnalyzeTurnoverTime" disabled="@(!_isAIAvailable)">
                    <i class="oi oi-magnifying-glass me-2"></i>
                    <span>@ResLoc["AnalyzeWorkingCapitalTurnover"]</span>
                </button>
            }
            
            @if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAnalysis">
                    <i class="oi oi-x me-2"></i>
                    @ResLoc["Clear"]
                </button>
            }
        </div>

        @if (_isAnalyzing || !string.IsNullOrEmpty(_aiAnalysis))
        {
            <div class="alert alert-info">
                @if (_isAnalyzing && string.IsNullOrEmpty(_aiAnalysis))
                {
                    <div class="d-flex align-items-center">
                        <span class="typing-indicator me-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span class="text-muted">AI is analyzing turnover timeline...</span>
                    </div>
                }
                <div style="white-space: pre-wrap; line-height: 1.6;">
                    @((MarkupString)FormatAIResponse(_aiAnalysis))
                </div>
            </div>
        }
    }
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>@ResLoc["Error"]:</strong> @_errorMessage
        </div>
    }
</RadzenCard>

@* Typing indicator styles are defined in dark-theme.css *@



@code {
private string? tableName;

List<ChartDateTimeItem>? money;
List<ChartDateTimeItem>? receivables;
List<ChartDateTimeItem>? materialValues;
    
private string _aiAnalysis = string.Empty;
private string _errorMessage = string.Empty;
private bool _isAnalyzing = false;
private bool _isCheckingAvailability = true;
private bool _isAIAvailable = false;

private readonly ApexChartOptions<ChartDateTimeItem> _lineChartOptions = 
    ApexChartsHelper.GetLineChartOptions<ChartDateTimeItem>();

protected override async Task OnInitializedAsync()
{
    // Initialize Y-axis title for localization
    _lineChartOptions.Yaxis = new List<YAxis>
    {
        new YAxis
        {
            Title = new AxisTitle { Text = ResLoc["days"].ToString() }
        }
    };
        
    string name = ResLoc["WorkingCapitalTurnoverTime"];
    string number = "III.";

    tableName = $"{number} {name}";

    money = WorkingCapitalTurnoverTimeChart.GetMoney();
    receivables = WorkingCapitalTurnoverTimeChart.GetReceivables();
    materialValues = WorkingCapitalTurnoverTimeChart.GetMaterialValues();
        
    await CheckAIAvailability();

    base.OnInitialized();
}

    private async Task CheckAIAvailability()
    {
        _isCheckingAvailability = true;
        StateHasChanged();

        try
        {
            var (isAvailable, _) = await AIAdvisor.CheckAvailabilityAsync();
            _isAIAvailable = isAvailable;
        }
        catch (Exception)
        {
            _isAIAvailable = false;
        }
        finally
        {
            _isCheckingAvailability = false;
            StateHasChanged();
        }
    }

    private async Task AnalyzeTurnoverTime()
    {
        if (!_isAIAvailable)
        {
            _errorMessage = "Chrome AI is not available. Please check the setup instructions.";
            return;
        }

        _isAnalyzing = true;
        _errorMessage = string.Empty;
        _aiAnalysis = string.Empty;
        StateHasChanged();

        try
        {
            var prompt = BuildTurnoverTimePrompt();
            
            await AIAdvisor.GetStreamingResponseAsync(prompt, chunk =>
            {
                _aiAnalysis += chunk;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("cancelled") || ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrEmpty(_aiAnalysis))
                {
                    _aiAnalysis += "\n\n[Analysis stopped by user]";
                }
                else
                {
                    _errorMessage = "Analysis was stopped by user.";
                }
            }
            else
            {
                _errorMessage = $"Failed to analyze data: {ex.Message}";
            }
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task StopAnalysis()
    {
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chromeai.js");
            await module.InvokeVoidAsync("abortCurrentOperation");
            
            if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                _aiAnalysis += "\n\n[Analysis stopped by user]";
            }
            
            _isAnalyzing = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping analysis: {ex.Message}");
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private string BuildTurnoverTimePrompt()
    {
        string languageInstruction = AFSConstraints.GetLanguageInstruction();

        // Use AOT-optimized JSON serialization
        var jsonData = JsonSerializationHelper.SerializeTurnoverTime(
            MainModel.CompanyName,
            money,
            receivables,
            materialValues
        );

        return $@"You are a financial analyst specializing in working capital management and cash conversion cycle analysis. Analyze the Working Capital Turnover Time for {MainModel.CompanyName}.

IMPORTANT: Respond in {languageInstruction} language.

CRITICAL FORMATTING RULES:
- DO NOT create or display any tables
- Focus on TRENDS, VELOCITY, and EFFICIENCY
- Use narrative prose with clear sections

Working Capital Turnover Time Data (in days):
{jsonData}

This shows the VELOCITY of working capital conversion - how fast:
1. Cash converts to inventory and back to cash
2. Receivables are collected
3. Materials/inventory turn over

Focus on:
- Trends over time (improving/deteriorating)
- Cash conversion cycle efficiency
- Seasonal patterns
- Velocity changes
- Recommendations for improvement

Provide 8-section analysis emphasizing efficiency and velocity trends.

Write entire response in {languageInstruction}. DO NOT CREATE ANY TABLES.";
    }

    private void ClearAnalysis()
    {
        _aiAnalysis = string.Empty;
        _errorMessage = string.Empty;
    }

    private static string FormatAIResponse(string response)
    {
        if (string.IsNullOrWhiteSpace(response))
            return string.Empty;

        return response
            .Replace("\n\n", "<br/><br/>")
            .Replace("\n", "<br/>")
            .Replace("**", "<strong>")
            .Replace("**", "</strong>")
            .Replace("- ", "• ");
    }
}
