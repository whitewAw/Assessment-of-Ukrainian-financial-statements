@page "/structureofaccountspayablecurrent"
@using AFS.Core.Models
@using AFS.Core.Interfaces
@using AFS.Core.Services
@using AFS.ComponentLibrary.Helpers
@implements IDisposable
@inject StructureOfAccountsPayableChart StructureOfAccountsPayableChart
@inject AfsModel AfsModel
@inject IAIFinancialAdvisor AIAdvisor
@inject IJSRuntime JS

<SeoHead Title="Accounts Payable Structure — Current Year | UFIN"
         Description="Visual breakdown of short-term liabilities and accounts payable composition for a Ukrainian business in the current reporting year." />

<RadzenCard>
    <h2 class="text-center">@tableName</h2>
    <PieSeriesComponent ChartAssets=@baseList />
</RadzenCard>

@* @ResLoc["AIFinancialAnalysis"] Section *@
<RadzenCard Style="margin-top: 20px;">
    <h3 class="text-center mb-4">
        <RadzenIcon Icon="psychology" class="me-2" />
        @ResLoc["AIFinancialAnalysis"]
    </h3>
    
    @if (_isCheckingAvailability)
    {
        <div class="d-flex justify-content-center mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span class="text-muted">@ResLoc["CheckingAIAvailability"]</span>
        </div>
    }
    else if (!_isAIAvailable)
    {
        <div class="alert alert-warning">
            <h6 class="alert-heading">
                <RadzenIcon Icon="warning" class="me-2" />
                @ResLoc["ChromeAINotAvailable"]
            </h6>
            <p class="mb-2">
                @ResLoc["ChromeAINotAvailableMessage"]
                <a href="/Assessment-of-Ukrainian-financial-statements/ai-assistant" class="alert-link">@ResLoc["AIAssistantPage"]</a>
                @ResLoc["ForSetupInstructions"]
            </p>
            <button class="btn btn-sm btn-primary" @onclick="CheckAIAvailability">
                <RadzenIcon Icon="refresh" class="me-2" />
                @ResLoc["RecheckAvailability"]
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3">
            @if (_isAnalyzing)
            {
                <button class="btn btn-danger me-2" @onclick="StopAnalysis">
                    <RadzenIcon Icon="stop" class="me-2" />
                    <span>@ResLoc["StopAnalysis"]</span>
                </button>
            }
            else
            {
                <button class="btn btn-primary me-2" @onclick="AnalyzePayableStructure" disabled="@(!_isAIAvailable)">
                    <RadzenIcon Icon="search" class="me-2" />
                    <span>@string.Format(ResLoc["AnalyzePayableStructure"], MainModel.CurrentYear)</span>
                </button>
            }
            
            @if (!string.IsNullOrEmpty(_aiAnalysis))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAnalysis">
                    <RadzenIcon Icon="close" class="me-2" />
                    @ResLoc["Clear"]
                </button>
            }
        </div>

        @if (_isAnalyzing || !string.IsNullOrEmpty(_aiAnalysis))
        {
            <div class="alert alert-info">
                @if (_isAnalyzing && string.IsNullOrEmpty(_aiAnalysis))
                {
                    <div class="d-flex align-items-center">
                        <span class="typing-indicator me-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span class="text-muted">AI is analyzing payable structure...</span>
                    </div>
                }
                <div style="white-space: pre-wrap; line-height: 1.6;">
                    @((MarkupString)FormatAIResponse(_aiAnalysis))
                </div>
            </div>
        }
    }
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>@ResLoc["Error"]:</strong> @_errorMessage
        </div>
    }
</RadzenCard>

@code {
private CancellationTokenSource? _cts;
private string? tableName;
IReadOnlyList<ChartDataItem>? baseList;


private string _aiAnalysis = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isAnalyzing = false;
    private bool _isCheckingAvailability = true;
    private bool _isAIAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();

        string name = ResLoc["StructureOfAccountsPayable"];
        string number = "VII.";

        tableName = $"{number} {name} - {MainModel.CurrentYear} {ResLoc["year"]}";
        baseList = StructureOfAccountsPayableChart.GetDataItem(false);

        await CheckAIAvailability();

        await base.OnInitializedAsync();
    }

    private async Task CheckAIAvailability() { _isCheckingAvailability = true; StateHasChanged(); _isAIAvailable = await AIAnalysisHelper.CheckAvailabilityAsync(AIAdvisor).ConfigureAwait(false); _isCheckingAvailability = false; StateHasChanged(); }

    private async Task AnalyzePayableStructure()
    {
        if (!_isAIAvailable)
        {
            _errorMessage = "Chrome AI is not available. Please check the setup instructions.";
            return;
        }

        _isAnalyzing = true;
        _errorMessage = string.Empty;
        _aiAnalysis = string.Empty;
        StateHasChanged();

        try
        {
            var prompt = BuildPayableStructurePrompt();
            
            await AIAdvisor.GetStreamingResponseAsync(prompt, chunk =>
            {
                _aiAnalysis += chunk;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("cancelled") || ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrEmpty(_aiAnalysis))
                {
                    _aiAnalysis += "\n\n[Analysis stopped by user]";
                }
                else
                {
                    _errorMessage = "Analysis was stopped by user.";
                }
            }
            else
            {
                _errorMessage = $"Failed to analyze data: {ex.Message}";
            }
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task StopAnalysis() { await AIAnalysisHelper.StopAnalysisAsync(JS).ConfigureAwait(false); _isAnalyzing = false; StateHasChanged(); }

    private string BuildPayableStructurePrompt()
    {
        string languageInstruction = AfsConstraints.GetLanguageInstruction();

        // Use AOT-optimized JSON serialization
        var jsonData = JsonSerializationHelper.SerializePayableStructure(
            MainModel.CompanyName,
            MainModel.CurrentYear,
            MainModel.BaseYear,
            baseList
        );

        return $@"You are a financial analyst specializing in accounts payable management and creditor relationship analysis. Analyze the Structure of Accounts Payable for {MainModel.CompanyName} for {MainModel.CurrentYear} (comparing to {MainModel.BaseYear}).

IMPORTANT: Respond in {languageInstruction} language.

Accounts Payable Structure Data:
{jsonData}

Focus on:
- Year-over-year changes in creditor structure
- Evolution of payment obligations
- Creditor relationship shifts
- Payment pattern changes
- Strategic implications

Provide 8-section analysis emphasizing changes and creditor relationship evolution.

Write entire response in {languageInstruction}. DO NOT CREATE ANY TABLES.";
    }

    private void ClearAnalysis()
    {
        _aiAnalysis = string.Empty;
        _errorMessage = string.Empty;
    }

    private static string FormatAIResponse(string response) => AIAnalysisHelper.FormatResponse(response);

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
