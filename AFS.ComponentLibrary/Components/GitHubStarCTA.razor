@* GitHub Star Call-to-Action Component *@
@inject IStringLocalizer<Resource> ResLoc

<div class="github-star-cta alert alert-info d-flex align-items-center justify-content-between" style="margin: 20px 0; border-left: 4px solid #0969da;">
    <div class="d-flex align-items-center">
        <svg aria-hidden="true" height="24" viewBox="0 0 16 16" version="1.1" width="24" style="fill: #0969da; margin-right: 12px;">
            <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z"></path>
        </svg>
        <div>
            <strong>@ResLoc["EnjoyingUFIN"]</strong>
            <p class="mb-0 text-muted small">@ResLoc["StarOnGitHubMessage"]</p>
        </div>
    </div>
    <a href="https://github.com/whitewAw/Assessment-of-Ukrainian-financial-statements" 
       target="_blank" 
       rel="noopener noreferrer"
       class="btn btn-primary d-flex align-items-center"
       @onclick="TrackStarClick">
        <svg aria-hidden="true" height="16" viewBox="0 0 16 16" version="1.1" width="16" style="fill: white; margin-right: 8px;">
            <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
        </svg>
        @ResLoc["StarOnGitHub"]
    </a>
</div>

@code {
    private static void TrackStarClick()
    {
        // Track analytics
        Console.WriteLine("[Analytics] User clicked Star on GitHub button");
    }
}
