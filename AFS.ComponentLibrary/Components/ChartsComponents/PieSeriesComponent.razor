@using AFS.Core.Models
@using AFS.ComponentLibrary.Helpers

<ApexChart TItem="ChartDataItem"
           Title="@Period"
           Height="350"
           Options="@_chartOptions">
    <ApexPointSeries TItem="ChartDataItem"
                     Items="ChartAssets"
                     Name="@ResLoc["Value"]"
                     SeriesType="SeriesType.Pie"
                     XValue="@(e => ResLoc[e.Item ?? string.Empty].ToString())"
                     YValue="@(e => (decimal)(e.Value ?? 0))" />
</ApexChart>

@code {
    [Parameter]
    public string? Period { get; set; }

    [Parameter]
    public List<ChartDataItem> ChartAssets { get; set; } = new();

    private static readonly ApexChartOptions<ChartDataItem> _chartOptions = 
        ApexChartsHelper.GetPieChartOptions<ChartDataItem>();
}
