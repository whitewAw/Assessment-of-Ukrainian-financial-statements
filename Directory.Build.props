<Project>
<PropertyGroup>
  <!-- Nullable reference types -->
  <Nullable>enable</Nullable>
    
  <!-- Implicit usings -->
  <ImplicitUsings>enable</ImplicitUsings>
    
  <!-- Code Analysis - Recommended level -->
  <AnalysisLevel>latest</AnalysisLevel>
  <AnalysisMode>Recommended</AnalysisMode>
    
  <!-- Enforce code style during build -->
  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    
    
    <!-- 
    ╔══════════════════════════════════════════════════════════════════════════════╗
    ║                    SUPPRESSED WARNINGS - DOCUMENTED REASONS                  ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ Category 1: NOT APPLICABLE TO BLAZOR WEBASSEMBLY                             ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ MA0004/CA2007 - ConfigureAwait not needed (single-threaded, no SyncContext)  ║
    ║ S6966 - Await in async methods - False positives in Blazor lifecycle         ║
    ║ S6562 - DateTimeKind - Not applicable in browser environment                 ║
    ║ CA1824 - NeutralResourcesLanguage - Not needed for client-side WASM          ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ Category 2: STYLE PREFERENCES (Low impact, not bugs)                         ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ MA0016 - Collection abstraction - ApexCharts/Radzen require List<T> for binding║
    ║ MA0048 - File name != type name - Related types grouped intentionally        ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ Category 3: MINOR ISSUES (Would require extensive changes for little gain)   ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ CA1031 - Catch specific exceptions - JS Interop can throw many exception types║
    ║ CA1711 - Suffix naming - Existing naming convention in codebase              ║
    ║ CA1724 - Type/namespace conflict - Existing design, low impact               ║
    ║ CA1816 - GC.SuppressFinalize - No finalizers in this codebase                ║
    ║ CA1848 - LoggerMessage delegates - Overkill for simple logging               ║
    ║ CA1852 - Seal types - Would limit extensibility                              ║
    ║ CA2201 - Reserved exceptions - Simple exception handling is sufficient       ║
    ║ CA2208 - ArgumentException - Existing patterns work correctly                ║
    ║ CA2254 - Static log templates - Dynamic messages are intentional             ║
    ╚══════════════════════════════════════════════════════════════════════════════╝
    -->
    
    <!-- Category 1: Not applicable to Blazor WASM -->
    <NoWarn>$(NoWarn);MA0004;CA2007;S6966;S6562;CA1824</NoWarn>
    
    <!-- Category 2: Style preferences -->
    <NoWarn>$(NoWarn);MA0016;MA0048</NoWarn>
    
    
    <!-- Category 3: Minor issues -->
    <NoWarn>$(NoWarn);CA1031;CA1711;CA1724;CA1816;CA1848;CA1852;CA2201;CA2208;CA2254</NoWarn>
    
    <!-- Additional Sonar rules -->
    <NoWarn>$(NoWarn);S112;S6667;S1172;S3928;S101;S3260;S3246;S1118;S125;S1075</NoWarn>
    
    
    <!-- Roslynator rules -->
    <NoWarn>$(NoWarn);RCS1021;RCS1036;RCS1037;RCS1102;RCS1118;RCS1124;RCS1141;RCS1163;RCS1181;RCS1194</NoWarn>
  </PropertyGroup>


  <!-- Code Analyzers - Applied to all projects -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.19">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.20.0.135146">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
