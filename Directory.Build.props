<Project>
<PropertyGroup>
  <!-- Nullable reference types -->
  <Nullable>enable</Nullable>

  <!-- Implicit usings -->
  <ImplicitUsings>enable</ImplicitUsings>

  <!-- Code Analysis - Recommended level -->
  <AnalysisLevel>latest</AnalysisLevel>
  <AnalysisMode>Recommended</AnalysisMode>

  <!-- Enforce code style during build -->
  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

  <!-- AOT/Trimming Safety - Enable analyzers (trimming is configured per-project) -->
  <IsAotCompatible>true</IsAotCompatible>
  <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

  <!-- Treat all warnings as errors for stricter code quality -->
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <!-- RUNTIME FEATURE SWITCHES - Safe for AOT/WASM                          -->
  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <!-- Disable unused runtime features (safe for all project types) -->
  <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  <EventSourceSupport>false</EventSourceSupport>
  <!-- Replace BCL exception/resource messages with lookup keys (~100 KB WASM saving).
       Trade-off: BCL errors in dev console become terse codes instead of full prose. -->
  <UseSystemResourceKeys>true</UseSystemResourceKeys>
  <!-- XmlUrlResolver/XmlDocument.Load network stack (we don't use XmlReader with remote URIs) -->
  <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
  <!-- COM interop is meaningless in WASM / browser -->
  <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  <!-- macOS/iOS-only native autorelease pools -->
  <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  <!-- C++/CLI hosting (Windows-only, not applicable to WASM) -->
  <EnableCppCLIHostActivation>false</EnableCppCLIHostActivation>
  <!-- Legacy UTF-7 encoding (unsafe, obsolete) -->
  <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>

  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <!-- RESTORE / LOCK FILES - Deterministic dependency graph for CI           -->
  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <!-- Generate packages.lock.json next to each csproj on restore. CI must run
       restore in locked mode to fail on any unintended graph change. -->
  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

  </PropertyGroup>


  <!-- Code Analyzers - Applied to all projects (versions in Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
