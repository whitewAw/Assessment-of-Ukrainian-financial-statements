@page "/ai-assistant"
@page "/Assessment-of-Ukrainian-financial-statements/ai-assistant"
@page "/aiassistant"
@page "/Assessment-of-Ukrainian-financial-statements/aiassistant"
@using AFS.ComponentLibrary.Components
@using AFS.ComponentLibrary.Resources
@using AFS.Core.Interfaces
@implements IDisposable
@inject IStringLocalizer<Resource> ResLoc
@inject IAIFinancialAdvisor AIAdvisor

<PageTitle>@ResLoc["AIFinancialAssistant"] - UFIN</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <h1>
                    <RadzenIcon Icon="psychology" class="me-2" />
                    @ResLoc["AIFinancialAssistant"]
                </h1>
                <p class="lead text-muted">
                    @ResLoc["AIAssistantSubtitle"]
                </p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <RadzenIcon Icon="chat" class="me-2" />
                        @ResLoc["ChatWithAI"]
                    </h5>
                </div>
                <div class="card-body p-0">
                    <AIFinancialChatComponent />
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @if (!_isAIAvailable)
            {
            <div class="card shadow-lg mb-3 border-warning setup-required-card" style="border-width: 2px !important;">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0 fw-bold">
                        <span class="pulse-icon me-2">⚠️</span>
                        @ResLoc["SetupRequired"]
                    </h6>
                </div>
                <div class="card-body" style="background: linear-gradient(135deg, #fff3cd 0%, #ffeeba 100%);">
                    <div class="alert alert-warning border-warning mb-3 py-2" role="alert">
                        <strong>🤖 @ResLoc["BrowserAI"]</strong>
                        <div class="small mt-1">Chrome AI is not enabled in your browser.</div>
                    </div>
                    <h6 class="fw-bold mb-2">📋 Steps to enable:</h6>
                    <ol class="mb-3 ps-3">
                        <li class="mb-1">@ResLoc["SetupStep1"]</li>
                        <li class="mb-1">@ResLoc["SetupStep2"]</li>
                        <li class="mb-1">@ResLoc["SetupStep3"]</li>
                    </ol>
                    <div class="d-grid gap-2">
                        <a href="https://github.com/whitewAw/Assessment-of-Ukrainian-financial-statements/blob/main/BROWSER_AI_SETUP.md"
                           target="_blank"
                           class="btn btn-warning fw-bold">
                            <RadzenIcon Icon="open_in_new" class="me-1" />
                            @ResLoc["ViewSetupGuide"]
                        </a>
                        <button class="btn btn-outline-dark btn-sm" @onclick="CheckAIAvailability">
                            <RadzenIcon Icon="refresh" class="me-1" /> Recheck AI Status
                        </button>
                    </div>
                </div>
            </div>
            }

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <RadzenIcon Icon="info" class="me-2" />
                        @ResLoc["HowToUse"]
                    </h6>
                </div>
                <div class="card-body">
                    <h6 class="fw-bold">@ResLoc["QuickActions"]</h6>
                    <ul class="small">
                        <li>@((MarkupString)ResLoc["QuickAction1"].Value)</li>
                        <li>@((MarkupString)ResLoc["QuickAction2"].Value)</li>
                        <li>@((MarkupString)ResLoc["QuickAction3"].Value)</li>
                    </ul>

                    <h6 class="fw-bold mt-3">@ResLoc["AskQuestions"]</h6>
                    <ul class="small">
                        <li>@ResLoc["ExampleQuestion1"]</li>
                        <li>@ResLoc["ExampleQuestion2"]</li>
                        <li>@ResLoc["ExampleQuestion3"]</li>
                        <li>@ResLoc["ExampleQuestion4"]</li>
                    </ul>

                    <h6 class="fw-bold mt-3">@ResLoc["Tips"]</h6>
                    <ul class="small mb-0">
                        <li>@ResLoc["Tip1"]</li>
                        <li>@ResLoc["Tip2"]</li>
                        <li>@ResLoc["Tip3"]</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">
                        <RadzenIcon Icon="security" class="me-2" />
                        @ResLoc["PrivacyAndSecurity"]
                    </h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-success mb-0" role="alert">
                        <p class="small mb-2">
                            <strong>🔒 @ResLoc["PrivateTitle"]</strong><br />
                            @ResLoc["PrivateDescription"]
                        </p>
                        <p class="small mb-2">
                            <strong>🚫 @ResLoc["NoDataSentTitle"]</strong><br />
                            @ResLoc["NoDataSentDescription"]
                        </p>
                        <p class="small mb-0">
                            <strong>✈️ @ResLoc["OfflineCapableTitle"]</strong><br />
                            @ResLoc["OfflineCapableDescription"]
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <RadzenIcon Icon="help" class="me-2" />
                        @ResLoc["FAQ"]
                    </h5>
                    
                    <div class="faq-container">
                        <!-- FAQ Item 1 -->
                        <details class="faq-item">
                            <summary class="faq-question">
                                <span class="question-text">@ResLoc["FAQQuestion1"]</span>
                                <span class="chevron">▼</span>
                            </summary>
                            <div class="faq-answer">
                                @ResLoc["FAQAnswer1"]
                            </div>
                        </details>

                        <!-- FAQ Item 2 -->
                        <details class="faq-item">
                            <summary class="faq-question">
                                <span class="question-text">@ResLoc["FAQQuestion2"]</span>
                                <span class="chevron">▼</span>
                            </summary>
                            <div class="faq-answer">
                                @ResLoc["FAQAnswer2"]
                            </div>
                        </details>

                        <!-- FAQ Item 3 -->
                        <details class="faq-item">
                            <summary class="faq-question">
                                <span class="question-text">@ResLoc["FAQQuestion3"]</span>
                                <span class="chevron">▼</span>
                            </summary>
                            <div class="faq-answer">
                                @ResLoc["FAQAnswer3"]
                            </div>
                        </details>

                        <!-- FAQ Item 4 -->
                        <details class="faq-item">
                            <summary class="faq-question">
                                <span class="question-text">@ResLoc["FAQQuestion4"]</span>
                                <span class="chevron">▼</span>
                            </summary>
                            <div class="faq-answer">
                                @ResLoc["FAQAnswer4"]
                            </div>
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.page-header h1 {
    color: #0d6efd;
    font-weight: 600;
}

.card {
    border-radius: 8px;
}

.card-header {
    font-weight: 500;
}

/* Setup Required Card - Highlighted for visibility */
.setup-required-card {
    box-shadow: 0 4px 20px rgba(255, 193, 7, 0.5) !important;
    animation: pulse-glow 2s ease-in-out infinite;
}

.setup-required-card .card-header,
.setup-required-card .card-body,
.setup-required-card .card-body * {
    color: #212529 !important;
}

.setup-required-card .alert {
    background-color: rgba(255, 193, 7, 0.3) !important;
    color: #212529 !important;
}

.setup-required-card .btn-warning {
    color: #212529 !important;
}

.setup-required-card .btn-outline-dark {
    color: #212529 !important;
    border-color: #212529 !important;
}

.pulse-icon {
    display: inline-block;
    animation: pulse-scale 1.5s ease-in-out infinite;
    font-size: 1.1rem;
}

@@keyframes pulse-glow {
    0%, 100% { box-shadow: 0 4px 20px rgba(255, 193, 7, 0.5); }
    50% { box-shadow: 0 6px 30px rgba(255, 193, 7, 0.8); }
}

@@keyframes pulse-scale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
}

    /* Native HTML Details/Summary FAQ - No JavaScript Required */
    .faq-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .faq-item {
        border: 1px solid rgba(0, 0, 0, 0.125);
        border-radius: 6px;
        background-color: #fff;
        overflow: hidden;
        transition: box-shadow 0.2s ease;
    }

    /* Dark mode support */
    @@media (prefers-color-scheme: dark) {
        .faq-item {
            border-color: rgba(255, 255, 255, 0.2);
            background-color: #2b3035;
        }
    }

    .faq-item:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    @@media (prefers-color-scheme: dark) {
        .faq-item:hover {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        }
    }

    .faq-question {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        cursor: pointer;
        user-select: none;
        list-style: none;
        color: #212529;
        font-weight: 500;
        background-color: #fff;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Dark mode for question */
    @@media (prefers-color-scheme: dark) {
        .faq-question {
            color: #e9ecef !important;
            background-color: #2b3035;
        }

        .faq-question .question-text {
            color: #e9ecef !important;
        }
    }

    /* Light mode - ensure text is always dark when closed */
    .faq-question .question-text {
        color: #212529;
    }

    /* Remove default marker */
    .faq-question::-webkit-details-marker {
        display: none;
    }

    .faq-question::marker {
        display: none;
    }

    .faq-question:hover {
        background-color: #f8f9fa;
    }

    @@media (prefers-color-scheme: dark) {
        .faq-question:hover {
            background-color: #3a3f47;
        }

        .faq-question:hover .question-text {
            color: #e9ecef !important;
        }
    }

    .faq-item[open] .faq-question {
        background-color: #e7f3ff;
        color: #0d6efd;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    }

    .faq-item[open] .faq-question .question-text {
        color: #0d6efd !important;
    }

    @@media (prefers-color-scheme: dark) {
        .faq-item[open] .faq-question {
            background-color: #1a3a52;
            color: #6ea8fe;
            border-bottom-color: rgba(255, 255, 255, 0.2);
        }

        .faq-item[open] .faq-question .question-text {
            color: #6ea8fe !important;
        }
    }

    .question-text {
        flex: 1;
        padding-right: 1rem;
    }

    .chevron {
        font-size: 0.75rem;
        color: #6c757d;
        transition: transform 0.3s ease, color 0.2s ease;
        flex-shrink: 0; /* Prevent chevron from shrinking */
    }

    .faq-item[open] .chevron {
        transform: rotate(180deg);
        color: #0d6efd;
    }

    @@media (prefers-color-scheme: dark) {
        .faq-item[open] .chevron {
            color: #6ea8fe;
        }
    }

    .faq-answer {
        padding: 1rem 1.25rem;
        color: #212529;
        background-color: #fff;
        line-height: 1.6;
        animation: fadeIn 0.3s ease;
    }

    /* Dark mode for answer */
    @@media (prefers-color-scheme: dark) {
        .faq-answer {
            color: #dee2e6;
            background-color: #2b3035;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Focus state for accessibility */
    .faq-question:focus {
        outline: 2px solid #0d6efd;
        outline-offset: 2px;
    }

    @@media (prefers-color-scheme: dark) {
        .faq-question:focus {
            outline-color: #6ea8fe;
        }
    }

    /* Mobile optimization */
    @@media (max-width: 768px) {
        .faq-question {
            padding: 0.875rem 1rem;
            font-size: 0.95rem;
        }

        .faq-answer {
            padding: 0.875rem 1rem;
            font-size: 0.9rem;
        }
    }
</style>

@code {
private CancellationTokenSource? _cts;
private bool _isAIAvailable = true; // Default to true, will be checked on init

protected override async Task OnInitializedAsync()
{
    _cts = new CancellationTokenSource();
    await CheckAIAvailability();
}

private async Task CheckAIAvailability()
{
    try
    {
        var (isAvailable, _) = await AIAdvisor.CheckAvailabilityAsync();
        _isAIAvailable = isAvailable;
    }
        catch
        {
            _isAIAvailable = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
