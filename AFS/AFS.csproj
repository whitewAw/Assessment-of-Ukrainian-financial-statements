<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		
		<!-- Globalization Settings - Optimize for specific cultures -->
		<InvariantGlobalization>false</InvariantGlobalization>
		<BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
		<BlazorIcuDataFileName>icudt.dat</BlazorIcuDataFileName>
		
		<!-- Performance Optimizations -->
		<BlazorEnableCompression>true</BlazorEnableCompression>
		<BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
		
		<!-- AOT Compilation - Full AOT for best runtime performance -->
		<RunAOTCompilation>true</RunAOTCompilation>
		<WasmStripILAfterAOT>true</WasmStripILAfterAOT>
		
		<!-- WASM SIMD - Enable for better math/calculation performance -->
		<WasmEnableSIMD>true</WasmEnableSIMD>
		
		<!-- Exception handling optimization -->
		<WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
		
		<!-- Trimming Settings - Changed to partial for Blazor component compatibility -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IlcOptimizationPreference>Size</IlcOptimizationPreference>
		
		<!-- Enable linking in Debug builds too (reduces bundle size) -->
		<BlazorWebAssemblyEnableLinking Condition="'$(Configuration)' == 'Debug'">true</BlazorWebAssemblyEnableLinking>
		
		<!-- Additional Optimizations -->
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<InvariantTimezone>false</InvariantTimezone>
		<WasmBuildNative>true</WasmBuildNative>
		<WasmNativeStrip>true</WasmNativeStrip>
		<EmccLinkOptimizationFlag>-Oz</EmccLinkOptimizationFlag>
		
		<!-- Enable expression tree support for Radzen reflection -->
		<IlcDisableReflection>false</IlcDisableReflection>
		
		<!-- Suppress known Blazor framework trimming warnings that are false positives -->
		<!-- IL2110/IL2111: Router.NotFoundPage and LayoutView.Layout use DynamicallyAccessedMembers -->
		<!-- These are safe in Blazor WebAssembly as the components are preserved by TrimmerRootAssembly -->
		<NoWarn>$(NoWarn);IL2110;IL2111</NoWarn>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AFS.ComponentLibrary\AFS.ComponentLibrary.csproj" />
		<ProjectReference Include="..\AFS.Core\AFS.Core.csproj" />
	</ItemGroup>

	<ItemGroup> 
		<Folder Include="wwwroot\images\" />
	</ItemGroup>
	
	<!-- Preserve only Radzen for reflection - let trimmer optimize app assemblies -->
	<ItemGroup>
		<TrimmerRootAssembly Include="Radzen.Blazor" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Update="Meziantou.Analyzer" Version="3.0.19" />
	  <PackageReference Update="Roslynator.Analyzers" Version="4.15.0" />
	  <PackageReference Update="SonarAnalyzer.CSharp" Version="10.20.0.135146" />
	</ItemGroup>

</Project>
