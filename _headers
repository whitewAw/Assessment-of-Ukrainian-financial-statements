# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Framework files - immutable cache.
# NOTE: We deliberately do NOT set Content-Encoding here.
# Netlify auto-negotiates Brotli/gzip for compressible MIME types.
# Forcing Content-Encoding: br on raw (uncompressed) files causes
# ERR_CONTENT_DECODING_FAILED in the browser.
/_framework/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets - not fingerprinted, so revalidate (matches netlify.toml)
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# WebAssembly files - immutable cache + correct MIME type
/*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

# Service worker - no cache (must always check for updates)
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML files - always revalidate (matches netlify.toml)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
