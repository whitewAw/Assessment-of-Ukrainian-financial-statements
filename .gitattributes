# Normalize line endings; keep LF for files executed/parsed on Linux CI runners
* text=auto

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mjs  text eol=lf

*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf

*.png binary
*.ico binary
*.jpg binary
*.webp binary
*.woff binary
*.woff2 binary
